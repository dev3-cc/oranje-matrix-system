        </mxCell>
        <mxCell id="e15" edge="1" parent="1" source="c-zone" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;fontSize=10;strokeColor=#5E35B1;exitX=1;exitY=0.8;entryX=0;entryY=0.2;" target="t-userzone" value="N:M">

<mxfile host="Electron" compressed="false" pages="3">
  <diagram id="v2-er" name="1 - ER con cardinalidades">
    <mxGraphModel dx="1329" dy="777" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="12000" pageHeight="12000" math="0" shadow="0">
      <root>
        <mxCell id="0" />

        <mxCell id="e11" edge="1" parent="1" source="t-contact" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;fontSize=10;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="t-attempt" value="1:N&lt;br&gt;hotel_contact_id">
          <mxGeometry relative="1" as="geometry" />

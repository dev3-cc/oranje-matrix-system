          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e14" edge="1" parent="1" source="c-user" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;fontSize=10;strokeColor=#5E35B1;exitX=1;exitY=0.2;entryX=0;entryY=0.4;" target="t-userzone" value="N:M">

          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" edge="1" parent="1" source="c-state" target="p-worker" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;fontSize=10;dashed=1;" value="1:N  estado actual">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" edge="1" parent="1" source="c-user" target="p-worker" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;fontSize=10;" value="1:1  el login">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" edge="1" parent="1" source="p-worker" target="p-doc" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;fontSize=10;" value="1:N">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" edge="1" parent="1" source="p-worker" target="p-hist" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;fontSize=10;" value="1:N  el timeline">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" edge="1" parent="1" source="p-worker" target="cv-assign" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;fontSize=10;" value="1:N  una a la vez por slot">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" edge="1" parent="1" source="d-slot" target="cv-assign" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;fontSize=10;" value="1:1  activa">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" edge="1" parent="1" source="p-worker" target="cv-black" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;fontSize=10;" value="1:0..1  y es para siempre">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" edge="1" parent="1" source="d-req" target="cv-part" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;fontSize=10;" value="1:N">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e13" edge="1" parent="1" source="c-user" target="cv-part" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;fontSize=10;dashed=1;" value="1:N  la Reclutadora">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pgc2" name="2 - Normalizacion y desviaciones">
    <mxGraphModel dx="862" dy="608" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1680" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=8;fontSize=13;" value="&lt;b&gt;Normalización, cardinalidades y las desviaciones de nombre&lt;/b&gt;&lt;br&gt;Por qué cada tabla está donde está, qué se guardó a propósito aunque se pueda derivar, y los tres nombres que NO coinciden con el vault — para que nadie los &quot;corrija&quot; de vuelta." vertex="1">
          <mxGeometry height="90" width="1000" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="n2-split" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;1 · Por qué personal/ va aparte de coverage/&lt;/b&gt;&lt;br&gt;&lt;br&gt;La razón es de &lt;b&gt;permisos, no de orden&lt;/b&gt;. El expediente lleva &lt;b&gt;SSN e ITIN&lt;/b&gt;, que necesitan cifrado de campo con la llave en Secret Manager. Un esquema propio es &lt;b&gt;un solo GRANT/REVOKE&lt;/b&gt; en vez de permisos columna por columna.&lt;br&gt;&lt;br&gt;El corte quedó limpio:&lt;br&gt;&lt;br&gt;&lt;b&gt;personal/&lt;/b&gt; — quién es la persona&lt;br&gt;· worker&lt;br&gt;· worker_document&lt;br&gt;· worker_state_history&lt;br&gt;&lt;br&gt;&lt;b&gt;coverage/&lt;/b&gt; — qué está haciendo&lt;br&gt;· assignment&lt;br&gt;· participation&lt;br&gt;· blacklist_entry&lt;br&gt;&lt;br&gt;El criterio: &lt;b&gt;la persona sobrevive a todas sus asignaciones.&lt;/b&gt; Distinto ciclo de vida, distinto esquema.&lt;br&gt;&lt;br&gt;&lt;b&gt;Cuesta:&lt;/b&gt; el proyecto pasa de 10 a &lt;b&gt;11 esquemas&lt;/b&gt;, y eso cierra el pendiente 3 de la Fase 0 del Plan. Reversible con &lt;font face=&quot;Courier New&quot;&gt;ALTER TABLE ... SET SCHEMA&lt;/font&gt;, igual que D-01." vertex="1">
          <mxGeometry height="400" width="620" x="40" y="140" as="geometry" />
        </mxCell>
        <mxCell id="n2-desv" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;2 · Tres nombres que NO son los del vault&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;a) edad → birth_date.&lt;/b&gt; Colaborador.md pide &quot;Edad&quot; en la Fase 1. Guardar la edad es guardar un dato que &lt;b&gt;se vuelve falso solo&lt;/b&gt;: en 12 meses toda la tabla miente. Se guarda la fecha de nacimiento y la edad se calcula al leer. Es la misma lógica por la que el Semáforo de Urgencia no guarda &quot;horas restantes&quot;.&lt;br&gt;&lt;br&gt;&lt;b&gt;b) Cuatro selects que NO son catálogos.&lt;/b&gt; &lt;i&gt;09 - Campos del Formulario&lt;/i&gt; sí lista sus valores, y son &lt;b&gt;listas cerradas&lt;/b&gt;: el negocio no agrega opciones de experiencia ni tipos de sangre. Por el criterio de la sección 5 (catálogo solo si el negocio agrega valores sin avisar) van como &lt;font face=&quot;Courier New&quot;&gt;text&lt;/font&gt; + CHECK:&lt;br&gt;&lt;br&gt;· &lt;b&gt;experience_level&lt;/b&gt; — Sin experiencia / 1-2 años / 3-5 años / Más de 5&lt;br&gt;· &lt;b&gt;transport_type&lt;/b&gt; — Propio / Transporte público / Otro&lt;br&gt;· &lt;b&gt;emergency_contact_relationship&lt;/b&gt; — Madre / Padre / Cónyuge / Hermano-a / Hijo-a / Amigo-a / Otro&lt;br&gt;· &lt;b&gt;blood_type&lt;/b&gt; — los 8 grupos, más &quot;No sé&quot;&lt;br&gt;&lt;br&gt;&lt;i&gt;Ojo con blood_type: &quot;No sé&quot; es un valor legítimo, no un NULL. La columna va NOT NULL.&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;c) Alergias y condiciones médicas → medical_notes.&lt;/b&gt; Textarea de 500 caracteres, un solo campo. No es una lista estructurada todavía." vertex="1">
          <mxGeometry height="400" width="620" x="700" y="140" as="geometry" />
        </mxCell>
        <mxCell id="n2-card" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;3 · Las cardinalidades, una por una&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;identity.user 1:1 personal.worker&lt;/b&gt;&lt;br&gt;Un login, una persona. &lt;font face=&quot;Courier New&quot;&gt;user_id&lt;/font&gt; es UNIQUE y nulable: nulable porque la Reclutadora puede capturar la Fase 1 antes de que el Colaborador tenga cuenta.&lt;br&gt;&lt;br&gt;&lt;b&gt;worker 1:N worker_document&lt;/b&gt;&lt;br&gt;Identificación, comprobante de domicilio, lo que la Reclutadora valide.&lt;br&gt;&lt;br&gt;&lt;b&gt;worker 1:N worker_state_history&lt;/b&gt;&lt;br&gt;Un renglón por transición. 12 estados, ~21 transiciones documentadas.&lt;br&gt;&lt;br&gt;&lt;b&gt;worker 1:N assignment&lt;/b&gt; — pero &lt;b&gt;slot 1:1 assignment activa&lt;/b&gt;&lt;br&gt;El colaborador acumula asignaciones a lo largo del tiempo; el slot solo tolera UNA activa. Ese es el índice único parcial de la restricción 3.&lt;br&gt;&lt;br&gt;&lt;b&gt;worker 1:0..1 blacklist_entry&lt;/b&gt;&lt;br&gt;Cero o uno, nunca dos: Negro es permanente, así que un segundo veto no significa nada.&lt;br&gt;&lt;br&gt;&lt;b&gt;requisition 1:N participation&lt;/b&gt;&lt;br&gt;Varias reclutadoras sobre la misma requisición — es literalmente RR-15." vertex="1">
          <mxGeometry height="430" width="620" x="40" y="570" as="geometry" />
        </mxCell>
        <mxCell id="n2-denorm" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;4 · Lo que se guarda aunque se pueda derivar&lt;/b&gt;&lt;br&gt;&lt;br&gt;Cada una es una decisión, no un descuido.&lt;br&gt;&lt;br&gt;&lt;b&gt;1. worker.status_light_state_id&lt;/b&gt; — el estado actual, cuando &lt;font face=&quot;Courier New&quot;&gt;worker_state_history&lt;/font&gt; ya lo tiene.&lt;br&gt;&lt;i&gt;Por qué: el Pool filtra por estado. Sin la columna, cada consulta del Pool tendría que buscar el último renglón del historial de cada colaborador. Es D-14, tal cual.&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;2. worker.status_light_id&lt;/b&gt; — siempre vale WORKER.&lt;br&gt;&lt;i&gt;Por qué: es lo que sostiene la FK compuesta que impide que un colaborador tome un estado de otro semáforo. Sin ella, Negro de Onboarding sería un estado válido de persona.&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;3. worker.zone_id&lt;/b&gt; — se podría derivar del domicilio.&lt;br&gt;&lt;i&gt;Por qué: derivarlo exige geocodificar la dirección, y el Pool filtra por zona en cada búsqueda. La zona la asigna la Reclutadora.&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;4. blacklist_entry.worker_id&lt;/b&gt; — el estado Negro ya está en el semáforo.&lt;br&gt;&lt;i&gt;Por qué: la evidencia es un archivo, y el motivo es texto libre. Ninguno de los dos cabe en un reason_id de catálogo.&lt;/i&gt;" vertex="1">
          <mxGeometry height="430" width="620" x="700" y="570" as="geometry" />
        </mxCell>
        <mxCell id="n2-fase1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;6 · La Fase 1 no tiene formulario documentado&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;09 - Campos del Formulario&lt;/i&gt; del Colaborador arranca en la &lt;b&gt;Fase 2&lt;/b&gt;: no hay tabla de campos, validaciones ni obligatoriedad para los 5 datos de la Fase 1 (nombre, edad, género, domicilio, teléfono). Se modelaron desde &lt;i&gt;Colaborador.md&lt;/i&gt;, que los lista pero no dice qué valida. Tiene sentido —los captura la Reclutadora en la entrevista, no el colaborador— pero entonces el formulario debería estar en el 09 de la Reclutadora, y ahí tampoco está." vertex="1">
          <mxGeometry height="130" width="1280" x="40" y="1030" as="geometry" />
        </mxCell>
        <mxCell id="n2-holes" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;5 · Huecos que este diagrama abre, y no cierra&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;a) La salida de Morado está en el archivo equivocado.&lt;/b&gt; El Semáforo del Colaborador solo documenta cómo se ENTRA (&quot;no asistió por causa propia&quot;). La salida existe, pero vive en &lt;i&gt;Simulación - Ciclo de Vida del Colaborador&lt;/i&gt;: &lt;b&gt;Morado → Naranja&lt;/b&gt;, la dispara el sistema cuando el colaborador vuelve a ponchar, y regresa a su &lt;b&gt;estado previo&lt;/b&gt; — el mismo patrón de Café. Hay que subirlo al semáforo antes de sembrar la transición; una simulación no es fuente de verdad.&lt;br&gt;&lt;br&gt;&lt;b&gt;b) Amarillo sale de TRES estados, no de uno.&lt;/b&gt; Esto no es un hueco: &lt;i&gt;09 - Campos del Formulario&lt;/i&gt; lo tiene escrito en el toggle de disponibilidad — solo se habilita si el colaborador está en &lt;b&gt;Verde fuerte, Naranja o Rosa&lt;/b&gt;. El Semáforo del Colaborador solo dice &quot;en descanso de un hotel&quot;, que se leía como Rosa nada más. Son tres filas de transición, no una, y las tres las dispara el propio colaborador sin aprobación.&lt;br&gt;&lt;br&gt;&lt;b&gt;c) El contador de inasistencias no existe todavía.&lt;/b&gt; &quot;3 inasistencias → Negro automático&quot; necesita contar algo, y lo que se cuenta son ponches faltantes: eso vive en &lt;font face=&quot;Courier New&quot;&gt;operations&lt;/font&gt;. Mientras no exista, la regla no puede dispararse sola. NO se agrega un &lt;font face=&quot;Courier New&quot;&gt;absence_count&lt;/font&gt; a &lt;font face=&quot;Courier New&quot;&gt;worker&lt;/font&gt;: sería un contador desnormalizado sin fuente que lo respalde, y quedaría desincronizado el primer día.&lt;br&gt;&lt;br&gt;&lt;b&gt;d) Contacto de emergencia: uno solo.&lt;/b&gt; Va como columnas porque el vault pide un contacto. Si el negocio pide dos, se parte a tabla hija — migración aditiva, sin tocar &lt;font face=&quot;Courier New&quot;&gt;worker&lt;/font&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;e) Hay DOS Morados más, y esos no se modelan.&lt;/b&gt; El Semáforo de Requisición y el de Posiciones también tienen Morado, pero ahí significa &lt;b&gt;&quot;Eliminada — eliminada físicamente&quot;&lt;/b&gt;. Un estado que describe una fila borrada no se puede observar: si la fila se va, no queda dónde guardarlo. Y como usamos borrado lógico, &lt;font face=&quot;Courier New&quot;&gt;deleted_at&lt;/font&gt; ya dice exactamente eso — el color sería una segunda fuente de verdad para el mismo hecho.&lt;br&gt;&lt;b&gt;Decisión (2026-08-12):&lt;/b&gt; las 3 filas PURPLE sembradas &lt;b&gt;se quedan&lt;/b&gt; —el vault las documenta y borrarlas haría que la base deje de coincidir con el documento— pero no se siembra ninguna transición hacia las dos de &quot;Eliminada&quot;, así que nunca se alcanzan. El Morado del Colaborador sí se usa: ese es &quot;No regresó&quot;, no eliminación. Verificado en la instancia: 0 requisiciones, 0 posiciones, 0 renglones de historial apuntando a esos estados." vertex="1">
          <mxGeometry height="380" width="1280" x="40" y="1190" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pgc3" name="3 - Restricciones que sostienen el modelo">
    <mxGraphModel dx="862" dy="608" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="3026" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=8;fontSize=13;" value="&lt;b&gt;Las restricciones que sostienen el modelo&lt;/b&gt;&lt;br&gt;El principio de los Estándares de Base de Datos: toda regla que pueda vivir como restricción, vive ahí y no en la aplicación. Estas son las de este diagrama, con lo que rechazan." vertex="1">
          <mxGeometry height="90" width="1000" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="r1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;1 · Un login, un colaborador&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#1A5276&quot;&gt;CREATE UNIQUE INDEX ux_worker_user ON personal.worker (user_id)&lt;br&gt;&amp;#160;&amp;#160;WHERE user_id IS NOT NULL AND deleted_at IS NULL;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Impide que dos expedientes cuelguen de la misma cuenta. Parcial porque user_id es nulable: la Reclutadora captura la Fase 1 antes de que exista la cuenta.&lt;/i&gt;" vertex="1">
          <mxGeometry height="156" width="1280" x="40" y="130" as="geometry" />
        </mxCell>
        <mxCell id="r2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;2 · El estado tiene que ser del semáforo del Colaborador&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#1A5276&quot;&gt;ALTER TABLE personal.worker ADD CONSTRAINT fk_worker_state&lt;br&gt;&amp;#160;&amp;#160;FOREIGN KEY (status_light_state_id, status_light_id)&lt;br&gt;&amp;#160;&amp;#160;REFERENCES catalogs.status_light_state (id, status_light_id);&lt;br&gt;&lt;br&gt;ALTER TABLE personal.worker ADD CONSTRAINT ck_worker_light&lt;br&gt;&amp;#160;&amp;#160;CHECK (status_light_id = '&lt;el id de WORKER&gt;');&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Sin la FK compuesta, un colaborador podría tomar CAFE del Onboarding — mismo color, otro significado. Es el mismo patrón de D-19 en demand.position.&lt;/i&gt;" vertex="1">
          <mxGeometry height="212" width="1280" x="40" y="306" as="geometry" />
        </mxCell>
        <mxCell id="r3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;3 · Un slot, una sola asignación activa&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#1A5276&quot;&gt;CREATE UNIQUE INDEX ux_slot_active_assignment&lt;br&gt;&amp;#160;&amp;#160;ON coverage.assignment (slot_id)&lt;br&gt;&amp;#160;&amp;#160;WHERE status = 'active';&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;ESTA es la que de verdad muerde: impide que dos colaboradores ocupen la misma plaza. El nombre ya venía escrito en la sección 2 de los Estándares. Es la mitad de RR-05 que sí se puede hacer cumplir hoy.&lt;/i&gt;" vertex="1">
          <mxGeometry height="184" width="1280" x="40" y="538" as="geometry" />
        </mxCell>
        <mxCell id="r4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;4 · El temporal lleva fecha de fin; el fijo, no&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#1A5276&quot;&gt;ALTER TABLE coverage.assignment ADD CONSTRAINT ck_assignment_validity&lt;br&gt;&amp;#160;&amp;#160;CHECK (&lt;br&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;(type = 'temporary' AND upper(validity) IS NOT NULL)&lt;br&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;OR (type = 'fixed'&amp;#160;&amp;#160;AND upper(validity) IS NULL)&lt;br&gt;&amp;#160;&amp;#160;);&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;El vault dice que la asignación temporal define sus días al momento de asignar y se cierra sola al vencer. La fija no tiene fin: termina cuando el hotel manda a descansar (Rosa). Sin este CHECK, un temporal sin fin nunca se cerraría.&lt;/i&gt;" vertex="1">
          <mxGeometry height="212" width="1280" x="40" y="742" as="geometry" />
        </mxCell>
        <mxCell id="r5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;5 · Sin SSN ni ITIN, retención automática&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#1A5276&quot;&gt;ALTER TABLE personal.worker ADD COLUMN has_tax_id boolean&lt;br&gt;&amp;#160;&amp;#160;GENERATED ALWAYS AS (&lt;br&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;ssn_encrypted IS NOT NULL OR itin_encrypted IS NOT NULL&lt;br&gt;&amp;#160;&amp;#160;) STORED;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Columna generada, no calculada por la app. La retención del 16% se dispara cuando esto es falso, y al ser GENERATED no puede quedar desincronizada: Postgres la recalcula en cada escritura.&lt;/i&gt;" vertex="1">
          <mxGeometry height="198" width="1280" x="40" y="974" as="geometry" />
        </mxCell>
        <mxCell id="r6" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;6 · Negro es permanente&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#1A5276&quot;&gt;-- No hay CHECK: lo hace cumplir el catálogo de transiciones.&lt;br&gt;CREATE UNIQUE INDEX ux_blacklist_worker&lt;br&gt;&amp;#160;&amp;#160;ON coverage.blacklist_entry (worker_id);&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;La permanencia no se programa: simplemente NO se siembra ninguna fila de status_light_transition que salga de Negro. El servicio de transición devuelve 409 porque la transición no existe. El índice único impide un segundo veto, que no significaría nada.&lt;/i&gt;" vertex="1">
          <mxGeometry height="198" width="1280" x="40" y="1192" as="geometry" />
        </mxCell>
        <mxCell id="r7" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;7 · Motivo y evidencia obligatorios en el veto manual&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#1A5276&quot;&gt;ALTER TABLE coverage.blacklist_entry ADD CONSTRAINT ck_blacklist_evidence&lt;br&gt;&amp;#160;&amp;#160;CHECK (&lt;br&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;source &lt;&gt; 'manual' OR evidence_path IS NOT NULL&lt;br&gt;&amp;#160;&amp;#160;);&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Blacklist.md: la falta grave manual exige motivo Y evidencia. El automático por inasistencias y el de disputa no traen archivo — su respaldo es el historial.&lt;/i&gt;" vertex="1">
          <mxGeometry height="198" width="1280" x="40" y="1410" as="geometry" />
        </mxCell>
        <mxCell id="r8" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;8 · El expediente no se borra&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#1A5276&quot;&gt;-- deleted_at en worker, y NADA de DELETE físico.&lt;br&gt;-- worker_document y worker_state_history: sin deleted_at,&lt;br&gt;-- son append-only (sección 4, tabla de excepciones).&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Blacklist.md es explícito: el colaborador NO se elimina, no aparece en búsquedas activas, y el historial se conserva íntegro. El borrado lógico es lo que permite las tres cosas a la vez.&lt;/i&gt;" vertex="1">
          <mxGeometry height="184" width="1280" x="40" y="1628" as="geometry" />
        </mxCell>
        <mxCell id="r9" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;9 · SSN e ITIN cifrados en la columna&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#1A5276&quot;&gt;ssn_encrypted&amp;#160;&amp;#160;bytea&amp;#160;&amp;#160; -- pgcrypto, llave en Secret Manager&lt;br&gt;itin_encrypted bytea&lt;br&gt;&lt;br&gt;REVOKE SELECT (ssn_encrypted, itin_encrypted)&lt;br&gt;&amp;#160;&amp;#160;ON personal.worker FROM app_user;&amp;#160;&amp;#160;-- salvo el rol de nómina&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Son los dos campos que obligan a que personal/ sea su propio esquema. Un dump de la base no debe alcanzar para leerlos. PRECIO DEL CIFRADO: 10 - Validaciones exige formato XXX-XX-XXXX para el SSN y 9XX-XX-XXXX para el ITIN (el ITIN empieza con 9), y sobre un bytea cifrado NO se puede escribir ese CHECK. Esas dos validaciones se quedan en Zod, en la aplicación, y son la única excepción consciente al principio de &quot;la regla vive en la base&quot;.&lt;/i&gt;" vertex="1">
          <mxGeometry height="254" width="1280" x="40" y="1832" as="geometry" />
        </mxCell>
        <mxCell id="r10" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;11 · Las 3 fases significan que casi nada puede ser NOT NULL&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#1A5276&quot;&gt;-- La fila nace con la Fase 1 y se completa despues.&lt;br&gt;ALTER TABLE personal.worker ADD COLUMN is_profile_complete boolean&lt;br&gt;&amp;#160;&amp;#160;GENERATED ALWAYS AS (&lt;br&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;catalog_position_id&amp;#160;&amp;#160;&amp;#160;&amp;#160; IS NOT NULL AND&lt;br&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;english_level_id&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;IS NOT NULL AND&lt;br&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;hiring_modality_id&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;IS NOT NULL AND&lt;br&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;experience_level&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;IS NOT NULL AND&lt;br&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;transport_type&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;IS NOT NULL AND&lt;br&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;emergency_contact_name&amp;#160;&amp;#160;IS NOT NULL AND&lt;br&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;emergency_contact_phone IS NOT NULL AND&lt;br&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;blood_type&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;IS NOT NULL&lt;br&gt;&amp;#160;&amp;#160;) STORED;&lt;br&gt;&lt;br&gt;-- Guard de la transicion Blanco -&gt; Verde fuerte:&lt;br&gt;--&amp;#160;&amp;#160; la Reclutadora no puede validar un perfil incompleto.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Este es el hallazgo de fondo de la revisión. 10 - Validaciones marca ocho campos como OBLIGATORIOS, y la tentación es ponerlos NOT NULL. No se puede: la Reclutadora captura la Fase 1 en la entrevista, y las Fases 2 y 3 las llena el propio colaborador después, desde la app. Entre una y otra la fila existe a medias — y eso ES el estado Blanco. &quot;Obligatorio&quot; es una regla del FORMULARIO, no de la columna. La columna generada le da al guard algo barato que leer, y la regla real queda donde pertenece: en la transición que saca al colaborador de Blanco.&lt;/i&gt;" vertex="1">
          <mxGeometry height="422" width="1280" x="40" y="2106" as="geometry" />
        </mxCell>
        <mxCell id="r11" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;10 · RR-05 NO está aquí&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#1A5276&quot;&gt;-- La restricción de exclusión por HORAS vive en operations,&lt;br&gt;-- sobre el turno del día:&lt;br&gt;EXCLUDE USING gist (worker_id WITH =, shift_range WITH &amp;&amp;)&lt;br&gt;-- shift_range es tstzrange: fecha Y hora reales.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Se decidió el 2026-08-12: el colaborador SÍ puede estar en dos hoteles el mismo día, si son horas distintas. Un daterange no puede expresarlo. Consecuencia: hasta que exista operations, el solape de horas solo lo evita la aplicación.&lt;/i&gt;" vertex="1">
          <mxGeometry height="198" width="1280" x="40" y="2548" as="geometry" />
        </mxCell>
        <mxCell id="r-check" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;Cómo se comprueba que muerden&lt;/b&gt;&lt;br&gt;&lt;br&gt;La Fase 4 del Plan pide tests que &lt;b&gt;intenten violar&lt;/b&gt; cada una y esperen el error del motor. Para este diagrama son seis:&lt;br&gt;&lt;br&gt;· dos expedientes con el mismo &lt;font face=&quot;Courier New&quot;&gt;user_id&lt;/font&gt;&lt;br&gt;· un colaborador tomando un estado del Semáforo Onboarding&lt;br&gt;· dos asignaciones activas sobre el mismo slot&lt;br&gt;· un &lt;font face=&quot;Courier New&quot;&gt;temporary&lt;/font&gt; sin fecha de fin&lt;br&gt;· una transición que salga de Negro&lt;br&gt;· un veto manual sin evidencia&lt;br&gt;&lt;br&gt;&lt;i&gt;Ninguno debe pasar. Si alguno pasa, la regla está en la aplicación y no en la base — que es justo lo que los Estándares prohíben.&lt;/i&gt;" vertex="1">
          <mxGeometry height="200" width="1280" x="40" y="2776" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

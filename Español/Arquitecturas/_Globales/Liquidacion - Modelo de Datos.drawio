<mxfile host="Electron" agent="Claude" pages="3">
  <diagram id="st1" name="1 - ER con cardinalidades">
    <mxGraphModel dx="862" dy="608" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="tit" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=8;fontSize=13;" value="&lt;b&gt;Liquidación — Modelo de datos&lt;/b&gt;&lt;br&gt;El esquema &lt;font face=&quot;Courier New&quot;&gt;settlement&lt;/font&gt;: donde el trabajo se vuelve dinero. Cierra la cadena del sistema.&lt;br&gt;Fuentes: &lt;i&gt;Flujo de Nómina&lt;/i&gt; (los 7 pasos), &lt;i&gt;Consolidado Semanal del Colaborador&lt;/i&gt;, &lt;i&gt;Deducciones&lt;/i&gt;, &lt;i&gt;Facturación al Hotel&lt;/i&gt; y &lt;i&gt;Vacaciones&lt;/i&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;Dos flujos de dinero en direcciones opuestas:&lt;/b&gt; Oranje le paga al Colaborador con el &lt;b&gt;pay rate&lt;/b&gt;, y el hotel le paga a Oranje con el &lt;b&gt;bill rate&lt;/b&gt;. La diferencia es el margen — y por eso son dos ramas separadas que nunca se mezclan." vertex="1">
          <mxGeometry height="140" width="900" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="leg" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;Cómo leer los colores&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#388E3C&quot;&gt;&lt;b&gt;Verde&lt;/b&gt;&lt;/font&gt; — tablas nuevas de &lt;font face=&quot;Courier New&quot;&gt;settlement&lt;/font&gt;.&lt;br&gt;&lt;font color=&quot;#B85C00&quot;&gt;&lt;b&gt;Naranja&lt;/b&gt;&lt;/font&gt; — columnas que hay que AGREGAR a tablas que ya existen.&lt;br&gt;&lt;b&gt;Gris&lt;/b&gt; — ya existe y no se toca.&lt;br&gt;&lt;font color=&quot;#C62828&quot;&gt;&lt;b&gt;Rojo&lt;/b&gt;&lt;/font&gt; — un hueco del vault.&lt;br&gt;&lt;br&gt;&lt;i&gt;La cadena completa:&lt;/i&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;commercial → demand → coverage → operations → settlement&lt;/font&gt;" vertex="1">
          <mxGeometry height="140" width="660" x="980" y="20" as="geometry" />
        </mxCell>
        <mxCell id="e-ts" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#9E9E9E;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;operations.timesheet&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt;&lt;br&gt;worker_id · requisition_id&lt;br&gt;week_start · status&lt;br&gt;&lt;br&gt;&lt;i&gt;Solo los APROBADOS entran a&lt;br&gt;nómina. Es D-09: solo el&lt;br&gt;ponche aprobado paga.&lt;/i&gt;" vertex="1">
          <mxGeometry height="160" width="250" x="60" y="220" as="geometry" />
        </mxCell>
        <mxCell id="e-contract" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;commercial.contract&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#B85C00&quot;&gt;+ 2 columnas&lt;/font&gt;&lt;br&gt;&lt;br&gt;pay/bill rate · 4 multiplicadores&lt;br&gt;&lt;font color=&quot;#B85C00&quot;&gt;&lt;b&gt;deducts_meals&lt;/b&gt;&lt;/font&gt; &lt;i&gt;(sí/no)&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#B85C00&quot;&gt;&lt;b&gt;splits_invoice_by_month&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Las dos las pide el vault y NO&lt;br&gt;las puse al crear el Contrato:&lt;br&gt;Deducciones dice &quot;configuración&lt;br&gt;del hotel: Deduce comida sí/no&quot; y&lt;br&gt;Facturación dice &quot;el Contrato indica&lt;br&gt;si el hotel requiere factura&lt;br&gt;partida&quot;.&lt;/i&gt;" vertex="1">
          <mxGeometry height="250" width="250" x="60" y="410" as="geometry" />
        </mxCell>
        <mxCell id="e-worker" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#9E9E9E;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;personal.worker&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt;&lt;br&gt;full_name · …&lt;br&gt;&lt;br&gt;&lt;i&gt;Sin cambios: el rate personal&lt;br&gt;vive en su propia tabla.&lt;/i&gt;" vertex="1">
          <mxGeometry height="110" width="250" x="60" y="690" as="geometry" />
        </mxCell>
        <mxCell id="t-wrate" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;personal.worker_rate&lt;/b&gt;&lt;br&gt;&lt;i&gt;el rate personal, con vigencia&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt;&lt;br&gt;worker_id&lt;br&gt;catalog_position_id &lt;i&gt;(NULO = todas)&lt;/i&gt;&lt;br&gt;rate&lt;br&gt;valid_from · valid_to&lt;br&gt;authorized_by · reason&lt;br&gt;created_at&lt;br&gt;&lt;br&gt;&lt;i&gt;El pay rate acordado entre Oranje y la&lt;br&gt;persona, por experiencia o antigüedad.&lt;br&gt;Puede ser MAYOR al del contrato, y la&lt;br&gt;diferencia la absorbe Oranje.&lt;br&gt;&lt;br&gt;Es TABLA y no columna porque un aumento&lt;br&gt;tiene que dejar rastro: quién lo autorizó&lt;br&gt;y desde cuándo. Con una columna se&lt;br&gt;perdería el rate anterior.&lt;br&gt;&lt;br&gt;Y lleva posición porque el mismo&lt;br&gt;colaborador puede ganar distinto como&lt;br&gt;Chef que como Housekeeper. NULO&lt;br&gt;significa &quot;todas sus posiciones&quot;.&lt;br&gt;&lt;br&gt;Solo Contabilidad lo ve.&lt;/i&gt;" vertex="1">
          <mxGeometry height="380" width="250" x="60" y="830" as="geometry" />
        </mxCell>
        <mxCell id="t-cons" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;settlement.consolidation&lt;/b&gt;&lt;br&gt;&lt;i&gt;lo que Oranje le paga al Colaborador&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt;&lt;br&gt;worker_id&lt;br&gt;week_start · week_end&lt;br&gt;gross_amount · deduction_amount&lt;br&gt;&lt;b&gt;net_amount&lt;/b&gt;&lt;br&gt;status &lt;i&gt;(DRAFT | VALIDATED | AUTHORIZED | PAID)&lt;/i&gt;&lt;br&gt;validated_by &lt;i&gt;(la Contadora)&lt;/i&gt;&lt;br&gt;authorized_by &lt;i&gt;(el Manager de Contabilidad)&lt;/i&gt;&lt;br&gt;paid_at&lt;br&gt;created_at · updated_at&lt;br&gt;&lt;br&gt;&lt;i&gt;Una fila por colaborador y por semana,&lt;br&gt;sin importar en cuántos hoteles trabajó.&lt;br&gt;&lt;br&gt;El &lt;b&gt;Pre-Payroll&lt;/b&gt; del Flujo de Nómina NO es&lt;br&gt;una tabla: es este mismo consolidado en&lt;br&gt;estado DRAFT. Dos estados, un renglón.&lt;/i&gt;" vertex="1">
          <mxGeometry height="380" width="380" x="400" y="220" as="geometry" />
        </mxCell>
        <mxCell id="t-consd" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;settlement.consolidation_detail&lt;/b&gt;&lt;br&gt;&lt;i&gt;el desglose, por requisición&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt;&lt;br&gt;consolidation_id&lt;br&gt;&lt;b&gt;requisition_id&lt;/b&gt; · hotel_id&lt;br&gt;catalog_position_id&lt;br&gt;regular_minutes · overtime_minutes&lt;br&gt;&lt;b&gt;pay_rate_applied&lt;/b&gt;&lt;br&gt;overtime_multiplier_applied&lt;br&gt;is_internal_rate &lt;i&gt;(¿se usó el personal?)&lt;/i&gt;&lt;br&gt;subtotal&lt;br&gt;&lt;br&gt;&lt;i&gt;Se rompe por REQUISICIÓN, no por hotel&lt;br&gt;(D-10): dos requisiciones del mismo hotel&lt;br&gt;evalúan su umbral de 40h por separado.&lt;br&gt;&lt;br&gt;El rate se GUARDA aquí, no se lee del&lt;br&gt;contrato. Ver la nota de abajo.&lt;/i&gt;" vertex="1">
          <mxGeometry height="400" width="380" x="400" y="630" as="geometry" />
        </mxCell>
        <mxCell id="t-ded" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;settlement.deduction&lt;/b&gt;&lt;br&gt;&lt;i&gt;lo que se le descuenta&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt;&lt;br&gt;consolidation_id&lt;br&gt;type &lt;i&gt;(UNIFORM | MEALS | TAX_RETENTION)&lt;/i&gt;&lt;br&gt;amount&lt;br&gt;source_note&lt;br&gt;refunded_at · refunded_by&lt;br&gt;created_at&lt;br&gt;&lt;br&gt;&lt;i&gt;Los TRES tipos que documenta el vault:&lt;br&gt;&lt;br&gt;&lt;b&gt;UNIFORM&lt;/b&gt; $15, lo dispara el Inspector.&lt;br&gt;Acumulable: si pierde otro, se suma.&lt;br&gt;&lt;br&gt;&lt;b&gt;MEALS&lt;/b&gt; $3 por día laborado, solo si el&lt;br&gt;contrato del hotel lo pide. &lt;b&gt;Tiene doble&lt;br&gt;efecto:&lt;/b&gt; se le descuenta al colaborador Y&lt;br&gt;se le acredita al hotel en su factura.&lt;br&gt;&lt;br&gt;&lt;b&gt;TAX_RETENTION&lt;/b&gt; 16% del cheque, si no&lt;br&gt;tiene SSN ni ITIN. Es &lt;b&gt;REEMBOLSABLE&lt;/b&gt;: por&lt;br&gt;eso lleva refunded_at.&lt;/i&gt;" vertex="1">
          <mxGeometry height="400" width="380" x="830" y="630" as="geometry" />
        </mxCell>
        <mxCell id="t-inv" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;settlement.invoice&lt;/b&gt;&lt;br&gt;&lt;i&gt;lo que el hotel le paga a Oranje&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt;&lt;br&gt;hotel_id&lt;br&gt;folio &lt;i&gt;(lo genera Oranje)&lt;/i&gt;&lt;br&gt;period_start · period_end&lt;br&gt;total_amount · credit_amount&lt;br&gt;status &lt;i&gt;(DRAFT | APPROVED | SENT | PAID)&lt;/i&gt;&lt;br&gt;approved_by &lt;i&gt;(el Manager de Contabilidad)&lt;/i&gt;&lt;br&gt;created_at · updated_at&lt;br&gt;&lt;br&gt;&lt;i&gt;Una por hotel y por semana — &lt;b&gt;salvo&lt;/b&gt; si&lt;br&gt;la semana cruza dos meses y el contrato&lt;br&gt;pide factura partida: entonces son DOS,&lt;br&gt;una por cada mes.&lt;br&gt;&lt;br&gt;Por eso la llave lleva el PERIODO y no&lt;br&gt;la semana. Ver restricción 4.&lt;/i&gt;" vertex="1">
          <mxGeometry height="380" width="380" x="830" y="220" as="geometry" />
        </mxCell>
        <mxCell id="t-invd" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;settlement.invoice_detail&lt;/b&gt;&lt;br&gt;&lt;i&gt;el desglose de la factura&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt;&lt;br&gt;invoice_id&lt;br&gt;requisition_id · worker_id&lt;br&gt;catalog_position_id&lt;br&gt;regular_minutes · overtime_minutes&lt;br&gt;&lt;b&gt;bill_rate_applied&lt;/b&gt;&lt;br&gt;overtime_multiplier_applied&lt;br&gt;subtotal&lt;br&gt;&lt;br&gt;&lt;i&gt;Usa el &lt;b&gt;bill rate&lt;/b&gt; y SOLO el bill rate.&lt;br&gt;El rate interno del colaborador &lt;b&gt;nunca&lt;/b&gt;&lt;br&gt;se refleja aquí — el hotel no debe saber&lt;br&gt;cuánto le paga Oranje a la persona.&lt;br&gt;&lt;br&gt;Es lo que protege el margen como&lt;br&gt;información interna.&lt;/i&gt;" vertex="1">
          <mxGeometry height="380" width="380" x="1260" y="220" as="geometry" />
        </mxCell>
        <mxCell id="n-congelar" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;Por qué el rate se GUARDA y no se lee&lt;/b&gt;&lt;br&gt;&lt;br&gt;Tanto &lt;font face=&quot;Courier New&quot;&gt;pay_rate_applied&lt;/font&gt; como &lt;font face=&quot;Courier New&quot;&gt;bill_rate_applied&lt;/font&gt; se copian a la fila en el momento de calcular, en vez de leerse del contrato cada vez.&lt;br&gt;&lt;br&gt;Es la decisión más importante de este esquema: &lt;b&gt;una nómina pagada no puede cambiar.&lt;/b&gt;&lt;br&gt;&lt;br&gt;Si el rate se leyera del contrato, subirlo un martes reescribiría el pasado — la nómina de la semana anterior mostraría números distintos a los que se pagaron, y una factura de hace seis meses no se podría explicar.&lt;br&gt;&lt;br&gt;Lo mismo con el multiplicador de overtime: se congela el que estaba vigente.&lt;br&gt;&lt;br&gt;&lt;i&gt;Es el mismo criterio de &lt;font face=&quot;Courier New&quot;&gt;punch_mark.inside_geofence&lt;/font&gt;: el veredicto de un momento no se recalcula con los datos de hoy.&lt;/i&gt;" vertex="1">
          <mxGeometry height="400" width="380" x="1260" y="630" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="e-ts" target="t-cons" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;fontSize=10;dashed=1;" value="N:1  agrupa los aprobados">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="t-cons" target="t-consd" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;fontSize=10;" value="1:N  uno por requisición">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="t-cons" target="t-ded" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;fontSize=10;" value="1:N">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" source="e-worker" target="t-cons" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;fontSize=10;dashed=1;" value="1:N">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" edge="1" parent="1" source="e-worker" target="t-wrate" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;fontSize=10;" value="1:N  su historial de rates">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" edge="1" parent="1" source="t-inv" target="t-invd" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;fontSize=10;" value="1:N">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" edge="1" parent="1" source="e-contract" target="t-inv" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;fontSize=10;dashed=1;" value="1:N  bill rate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="st2" name="2 - Decisiones y huecos">
    <mxGraphModel dx="862" dy="608" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1360" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=8;fontSize=13;" value="&lt;b&gt;Las decisiones, y los cuatro huecos que quedan&lt;/b&gt;&lt;br&gt;Qué se guarda, qué se calcula, y qué el vault todavía no dice." vertex="1">
          <mxGeometry height="80" width="1000" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="n2-vac" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;1 · Las vacaciones NO son una tabla&lt;/b&gt;&lt;br&gt;&lt;br&gt;Se calculan del histórico. La fórmula del vault:&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#1A5276&quot;&gt;promedio = Σ horas netas de las últimas&lt;br&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; 52 semanas ÷ 52&lt;/font&gt;&lt;br&gt;&lt;br&gt;La fuente son los &lt;b&gt;Consolidados históricos&lt;/b&gt;, que ya están en este esquema. Guardar el promedio sería guardar un número que cambia cada semana.&lt;br&gt;&lt;br&gt;Lo que sí exige es que &lt;font face=&quot;Courier New&quot;&gt;consolidation_detail&lt;/font&gt; conserve el &lt;b&gt;rate, el hotel y la posición&lt;/b&gt; de cada renglón — porque el vault pide el desglose:&lt;br&gt;&lt;br&gt;&lt;i&gt;&quot;Cuando el colaborador trabajó con distintos rates, el sistema debe separar las semanas por rate y calcular el promedio de cada uno independientemente&quot;&lt;/i&gt;&lt;br&gt;&lt;br&gt;Sin esas tres columnas en el detalle, el desglose por hotel y por posición no se puede reconstruir. Con ellas, es una consulta.&lt;br&gt;&lt;br&gt;&lt;b&gt;Y menos de 52 semanas se promedia sobre las disponibles&lt;/b&gt;, así que el divisor es &lt;font face=&quot;Courier New&quot;&gt;count(*)&lt;/font&gt;, no la constante 52." vertex="1">
          <mxGeometry height="400" width="640" x="40" y="130" as="geometry" />
        </mxCell>
        <mxCell id="n2-ded" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;2 · La deducción de comida tiene DOS efectos&lt;/b&gt;&lt;br&gt;&lt;br&gt;Es la única de las tres que toca las dos ramas. El vault:&lt;br&gt;&lt;br&gt;&lt;i&gt;&quot;Se descuenta al colaborador &lt;b&gt;Y&lt;/b&gt; se acredita al hotel en su Factura&quot;&lt;/i&gt;&lt;br&gt;&lt;br&gt;O sea que los $3 salen del cheque del colaborador y **entran** como crédito en la factura — por eso &lt;font face=&quot;Courier New&quot;&gt;invoice&lt;/font&gt; lleva &lt;font face=&quot;Courier New&quot;&gt;credit_amount&lt;/font&gt; aparte del total.&lt;br&gt;&lt;br&gt;Las otras dos son solo del lado del colaborador: el &lt;b&gt;uniforme&lt;/b&gt; lo dispara el Inspector y se lo queda Oranje; la &lt;b&gt;retención del 16%&lt;/b&gt; se guarda para el fisco.&lt;br&gt;&lt;br&gt;&lt;b&gt;La retención es REEMBOLSABLE&lt;/b&gt;, y eso obliga a algo: hay que poder sumar todo lo retenido que aún no se devuelve. Por eso &lt;font face=&quot;Courier New&quot;&gt;deduction&lt;/font&gt; lleva &lt;font face=&quot;Courier New&quot;&gt;refunded_at&lt;/font&gt; en vez de borrarse — el saldo es &lt;font face=&quot;Courier New&quot;&gt;SUM(amount) WHERE type='TAX_RETENTION' AND refunded_at IS NULL&lt;/font&gt;.&lt;br&gt;&lt;br&gt;&lt;i&gt;Se evaluó una tabla de saldo acumulado y se descartó: sería un total desnormalizado que puede desincronizarse, cuando la suma es una consulta.&lt;/i&gt;" vertex="1">
          <mxGeometry height="400" width="640" x="700" y="130" as="geometry" />
        </mxCell>
        <mxCell id="n2-aum" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;3 · Un aumento de sueldo es una fila, no un UPDATE&lt;/b&gt;&lt;br&gt;&lt;br&gt;Hay &lt;b&gt;dos formas&lt;/b&gt; de que a un colaborador le suba el pago, y el modelo las trata distinto:&lt;br&gt;&lt;br&gt;&lt;b&gt;a) Se renegocia con el hotel&lt;/b&gt; → sube el &lt;font face=&quot;Courier New&quot;&gt;pay_rate&lt;/font&gt; del contrato. Eso ya está resuelto: contrato nuevo, el viejo se conserva, y el hotel paga más.&lt;br&gt;&lt;b&gt;b) Oranje se lo sube por su cuenta&lt;/b&gt; → una fila nueva en &lt;font face=&quot;Courier New&quot;&gt;worker_rate&lt;/font&gt;. El hotel no se entera y &lt;b&gt;la diferencia sale del margen de Oranje&lt;/b&gt;.&lt;br&gt;&lt;br&gt;Se evaluó una columna &lt;font face=&quot;Courier New&quot;&gt;internal_rate&lt;/font&gt; en &lt;font face=&quot;Courier New&quot;&gt;worker&lt;/font&gt; y se descartó. El argumento a favor era bueno: como cada consolidado &lt;b&gt;congela&lt;/b&gt; el rate aplicado, lo que se pagó cada semana ya queda registrado. Pero eso responde &lt;i&gt;&quot;cuánto cobró&quot;&lt;/i&gt;, no &lt;i&gt;&quot;quién le autorizó el aumento y desde cuándo&quot;&lt;/i&gt; — y un aumento sin autor es justo lo que nadie quiere explicar en una auditoría.&lt;br&gt;&lt;br&gt;&lt;b&gt;Lleva posición&lt;/b&gt; porque el mismo colaborador puede ganar distinto según lo que haga: más como Chef que como Housekeeper. &lt;font face=&quot;Courier New&quot;&gt;catalog_position_id&lt;/font&gt; nulo significa &quot;todas sus posiciones&quot;, así que la tabla cubre el aumento global y el específico con la misma forma.&lt;br&gt;&lt;br&gt;&lt;i&gt;Ojo con el nulo: el índice que impide dos rates vigentes a la vez necesita &lt;font face=&quot;Courier New&quot;&gt;NULLS NOT DISTINCT&lt;/font&gt;, porque en Postgres dos NULL son distintos entre sí. Es la misma trampa de status_light_transition.&lt;/i&gt;" vertex="1">
          <mxGeometry height="300" width="1300" x="40" y="560" as="geometry" />
        </mxCell>
        <mxCell id="n2-huecos" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;Los cuatro huecos&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;a) ¿Dónde se registra que el hotel AUTORIZÓ el overtime?&lt;/b&gt; &lt;i&gt;Facturación al Hotel&lt;/i&gt; es tajante: &lt;i&gt;&quot;solo se factura al hotel el overtime que el hotel autorizó. Si el colaborador trabajó horas extra no autorizadas, esas horas no se incluyen en la Factura — pero sí pueden pagarse al colaborador según decisión de Oranje&quot;&lt;/i&gt;.&lt;br&gt;Eso significa que el overtime tiene &lt;b&gt;dos números distintos&lt;/b&gt;: el que se le paga al colaborador y el que se le cobra al hotel. Y hoy &lt;font face=&quot;Courier New&quot;&gt;timesheet_day.overtime_minutes&lt;/font&gt; es uno solo. Falta la columna de &lt;b&gt;overtime autorizado&lt;/b&gt; — y falta saber quién y cuándo lo autoriza, porque el Manager de Área autoriza que se QUEDE, no necesariamente que se FACTURE.&lt;br&gt;&lt;br&gt;&lt;b&gt;b) Al Contrato le faltan dos campos.&lt;/b&gt; No los puse al crearlo, y los dos los pide el vault textualmente: &lt;font face=&quot;Courier New&quot;&gt;deducts_meals&lt;/font&gt; (&lt;i&gt;Deducciones&lt;/i&gt;: &quot;configuración del hotel en el Contrato, campo: Deduce comida sí/no&quot;) y &lt;font face=&quot;Courier New&quot;&gt;splits_invoice_by_month&lt;/font&gt; (&lt;i&gt;Facturación&lt;/i&gt;: &quot;el Contrato indica si el hotel requiere este comportamiento&quot;). Son dos columnas booleanas — migración aditiva.&lt;br&gt;&lt;br&gt;&lt;b&gt;c) El monto de las deducciones está en el vault, no en la base.&lt;/b&gt; Los $15 del uniforme y los $3 de comida están escritos en &lt;i&gt;Deducciones.md&lt;/i&gt; como constantes. ¿Son iguales para todos los hoteles, o se pactan en el contrato como los rates? Si se pactan, son dos columnas más del contrato. Mientras no se decida, el monto se guarda en la fila de la deducción —que es lo correcto de todas formas, porque hay que congelarlo— pero de dónde sale queda abierto.&lt;br&gt;&lt;br&gt;&lt;b&gt;d) El disparador del uniforme no existe todavía.&lt;/b&gt; &lt;i&gt;Deducciones&lt;/i&gt; dice que el &lt;b&gt;Inspector&lt;/b&gt; registra la entrega o pérdida vía formulario, y que eso genera la deducción. Pero no hay ningún módulo de Inspección modelado, así que hoy esa deducción se captura a mano. Es de &lt;font face=&quot;Courier New&quot;&gt;supervision&lt;/font&gt;, el esquema que sigue." vertex="1">
          <mxGeometry height="420" width="1300" x="40" y="890" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="st3" name="3 - Restricciones que sostienen el modelo">
    <mxGraphModel dx="862" dy="608" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="2407" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=8;fontSize=13;" value="&lt;b&gt;Las restricciones que sostienen el modelo&lt;/b&gt;&lt;br&gt;Aquí todas defienden dinero: un error en este esquema se paga, literalmente." vertex="1">
          <mxGeometry height="80" width="1000" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="r1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;1 · Un consolidado por colaborador y semana&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#1A5276&quot;&gt;CREATE UNIQUE INDEX ux_consolidation_worker_week&lt;br&gt;&amp;#160;&amp;#160;ON settlement.consolidation (worker_id, week_start);&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Una fila por persona y semana, sin importar en cuantos hoteles trabajo. Dos filas partirian el cheque en dos y el colaborador cobraria dos veces o ninguna.&lt;/i&gt;" vertex="1">
          <mxGeometry height="175" width="1280" x="40" y="130" as="geometry" />
        </mxCell>
        <mxCell id="r2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;2 · Un renglon por requisicion dentro del consolidado&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#1A5276&quot;&gt;CREATE UNIQUE INDEX ux_consolidation_detail_req&lt;br&gt;&amp;#160;&amp;#160;ON settlement.consolidation_detail (consolidation_id, requisition_id);&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Es lo que hace que el umbral de 40h se evalue por requisicion (D-10). Sin el, dos renglones de la misma requisicion romperian el acumulado y nadie llegaria al overtime.&lt;/i&gt;" vertex="1">
          <mxGeometry height="175" width="1280" x="40" y="325" as="geometry" />
        </mxCell>
        <mxCell id="r3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;3 · Solo lo autorizado se paga&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#1A5276&quot;&gt;ALTER TABLE settlement.consolidation&lt;br&gt;&amp;#160;&amp;#160;ADD CONSTRAINT ck_consolidation_authorization CHECK (&lt;br&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;(status IN ('AUTHORIZED','PAID')&lt;br&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; AND validated_by IS NOT NULL AND authorized_by IS NOT NULL)&lt;br&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;OR status IN ('DRAFT','VALIDATED'));&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;El Flujo de Nomina tiene DOS firmas: la Contadora valida y el Manager de Contabilidad autoriza. Un consolidado autorizado sin las dos es una nomina que nadie reviso — y el CHECK impide que exista.&lt;/i&gt;" vertex="1">
          <mxGeometry height="217" width="1280" x="40" y="520" as="geometry" />
        </mxCell>
        <mxCell id="r4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;4 · Una factura por hotel y periodo, no por semana&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#1A5276&quot;&gt;CREATE UNIQUE INDEX ux_invoice_hotel_period&lt;br&gt;&amp;#160;&amp;#160;ON settlement.invoice (hotel_id, period_start, period_end);&lt;br&gt;&lt;br&gt;CREATE UNIQUE INDEX ux_invoice_folio&lt;br&gt;&amp;#160;&amp;#160;ON settlement.invoice (folio);&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;La llave lleva el PERIODO y no la semana justamente por la factura partida: cuando una semana cruza dos meses y el contrato lo pide, son DOS facturas de la misma semana con periodos distintos. Con la semana en la llave, la segunda no cabria.&lt;/i&gt;" vertex="1">
          <mxGeometry height="231" width="1280" x="40" y="757" as="geometry" />
        </mxCell>
        <mxCell id="r5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;5 · Ningun monto negativo, y el neto cuadra&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#1A5276&quot;&gt;ALTER TABLE settlement.consolidation&lt;br&gt;&amp;#160;&amp;#160;ADD CONSTRAINT ck_consolidation_amounts CHECK (&lt;br&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;gross_amount &amp;gt;= 0 AND deduction_amount &amp;gt;= 0&lt;br&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;AND net_amount = gross_amount - deduction_amount&lt;br&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;AND net_amount &amp;gt;= 0);&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;La tercera condicion es la que importa: obliga a que el neto SEA la resta, no un numero que alguien escribio. Y la cuarta impide un cheque negativo — si las deducciones superan lo ganado, el sistema tiene que decidir que hacer, no emitir una deuda.&lt;/i&gt;" vertex="1">
          <mxGeometry height="231" width="1280" x="40" y="1008" as="geometry" />
        </mxCell>
        <mxCell id="r6" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;6 · El rate congelado nunca es cero&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#1A5276&quot;&gt;ALTER TABLE settlement.consolidation_detail&lt;br&gt;&amp;#160;&amp;#160;ADD CONSTRAINT ck_detail_rate CHECK (&lt;br&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;pay_rate_applied &amp;gt; 0&lt;br&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;AND regular_minutes &amp;gt;= 0 AND overtime_minutes &amp;gt;= 0);&lt;br&gt;&lt;br&gt;ALTER TABLE settlement.invoice_detail&lt;br&gt;&amp;#160;&amp;#160;ADD CONSTRAINT ck_invoice_detail_rate CHECK (&lt;br&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;bill_rate_applied &amp;gt; 0);&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Un rate en cero significaria trabajo gratis. Es el tipo de error que pasa cuando el calculo no encuentra el contrato vigente y escribe el default del lenguaje.&lt;/i&gt;" vertex="1">
          <mxGeometry height="259" width="1280" x="40" y="1259" as="geometry" />
        </mxCell>
        <mxCell id="r7" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;7 · El reembolso deja rastro&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#1A5276&quot;&gt;ALTER TABLE settlement.deduction&lt;br&gt;&amp;#160;&amp;#160;ADD CONSTRAINT ck_deduction_type CHECK (&lt;br&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;type IN ('UNIFORM','MEALS','TAX_RETENTION')),&lt;br&gt;&amp;#160;&amp;#160;ADD CONSTRAINT ck_deduction_refund CHECK (&lt;br&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;(refunded_at IS NULL AND refunded_by IS NULL)&lt;br&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;OR (refunded_at IS NOT NULL AND refunded_by IS NOT NULL)),&lt;br&gt;&amp;#160;&amp;#160;ADD CONSTRAINT ck_deduction_refundable CHECK (&lt;br&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;refunded_at IS NULL OR type = 'TAX_RETENTION');&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;La ultima es la que sorprende: SOLO la retencion del 16% es reembolsable. El uniforme y la comida no se devuelven, asi que marcarlos como reembolsados seria un error que nadie notaria hasta cuadrar la caja.&lt;/i&gt;" vertex="1">
          <mxGeometry height="259" width="1280" x="40" y="1538" as="geometry" />
        </mxCell>
        <mxCell id="r8" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;8 · Un solo rate personal vigente por posicion&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#1A5276&quot;&gt;CREATE UNIQUE INDEX ux_worker_rate_active&lt;br&gt;&amp;#160;&amp;#160;ON personal.worker_rate (worker_id, catalog_position_id)&lt;br&gt;&amp;#160;&amp;#160;NULLS NOT DISTINCT&lt;br&gt;&amp;#160;&amp;#160;WHERE valid_to IS NULL;&lt;br&gt;&lt;br&gt;ALTER TABLE personal.worker_rate&lt;br&gt;&amp;#160;&amp;#160;ADD CONSTRAINT ck_worker_rate CHECK (&lt;br&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;rate &amp;gt; 0 AND (valid_to IS NULL OR valid_to &amp;gt; valid_from));&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;PARCIAL y con NULLS NOT DISTINCT a la vez. Parcial porque el historial de aumentos se conserva y solo el ultimo esta vigente; NULLS NOT DISTINCT porque catalog_position_id nulo significa &quot;todas las posiciones&quot;, y sin la clausula dos filas globales pasarian las dos — en Postgres dos NULL son distintos entre si. Es la misma trampa de status_light_transition.&lt;/i&gt;" vertex="1">
          <mxGeometry height="287" width="1280" x="40" y="1817" as="geometry" />
        </mxCell>
        <mxCell id="r9" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;9 · Lo que la base NO puede impedir&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#1A5276&quot;&gt;-- Que el total del consolidado cuadre con la suma&lt;br&gt;-- de sus detalles y sus deducciones.&lt;br&gt;-- Un CHECK solo ve su propia fila.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Es la clase de invariante que necesita un trigger o una verificacion del servicio al cerrar la semana. Queda anotado aqui para que nadie lo busque en la base — y para que exista un test que lo compruebe, porque un consolidado descuadrado es dinero mal pagado.&lt;/i&gt;" vertex="1">
          <mxGeometry height="203" width="1280" x="40" y="2124" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

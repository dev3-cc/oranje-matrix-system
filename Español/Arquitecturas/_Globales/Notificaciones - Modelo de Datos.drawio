<mxfile host="Electron" agent="Claude" pages="3">
  <diagram id="nt1" name="1 - ER con cardinalidades">
    <mxGraphModel dx="862" dy="608" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1180" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="tit" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=8;fontSize=13;" value="&lt;b&gt;Notificaciones — Modelo de datos&lt;/b&gt;&lt;br&gt;El esquema &lt;font face=&quot;Courier New&quot;&gt;notifications&lt;/font&gt;: quién debe enterarse de qué. Es el último de los once.&lt;br&gt;Fuentes: el &lt;i&gt;Catálogo de Notificaciones&lt;/i&gt; (57 tipos extraídos de 107 archivos), &lt;i&gt;RF-C-09&lt;/i&gt; (la pantalla del Colaborador), &lt;b&gt;D-05&lt;/b&gt; (FCM) y &lt;i&gt;Estructura de Proyecto&lt;/i&gt;, que declara el módulo como &lt;b&gt;consumidor de eventos de Pub/Sub&lt;/b&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;Canal: solo push&lt;/b&gt; (2026-08-18). &lt;b&gt;Retención: leídas 30 días, no leídas para siempre.&lt;/b&gt;" vertex="1">
          <mxGeometry height="140" width="900" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="leg" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;Cómo leer los colores&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#388E3C&quot;&gt;&lt;b&gt;Verde&lt;/b&gt;&lt;/font&gt; — tablas nuevas de &lt;font face=&quot;Courier New&quot;&gt;notifications&lt;/font&gt;.&lt;br&gt;&lt;font color=&quot;#B85C00&quot;&gt;&lt;b&gt;Naranja&lt;/b&gt;&lt;/font&gt; — catálogo nuevo.&lt;br&gt;&lt;b&gt;Gris&lt;/b&gt; — ya existe.&lt;br&gt;&lt;font color=&quot;#C62828&quot;&gt;&lt;b&gt;Rojo&lt;/b&gt;&lt;/font&gt; — un hueco o una regla que la base no puede sostener.&lt;br&gt;&lt;br&gt;&lt;i&gt;Con esto los once esquemas quedan modelados.&lt;/i&gt;" vertex="1">
          <mxGeometry height="140" width="660" x="960" y="20" as="geometry" />
        </mxCell>
        <mxCell id="e-user" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#9E9E9E;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;identity.user&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt;&lt;br&gt;email · full_name&lt;br&gt;role_id · firebase_uid&lt;br&gt;&lt;br&gt;&lt;i&gt;El destinatario es SIEMPRE un usuario,&lt;br&gt;nunca un rol abstracto.&lt;br&gt;&lt;br&gt;El Colaborador también tiene renglón&lt;br&gt;aquí, así que hay un solo camino&lt;br&gt;para todos.&lt;/i&gt;" vertex="1">
          <mxGeometry height="200" width="250" x="60" y="220" as="geometry" />
        </mxCell>
        <mxCell id="t-type" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;catalogs.notification_type&lt;/b&gt;&lt;br&gt;&lt;i&gt;los 57 tipos&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt;&lt;br&gt;code&lt;br&gt;name · description&lt;br&gt;module&lt;br&gt;is_active&lt;br&gt;&lt;br&gt;&lt;i&gt;Es CATÁLOGO y no text + CHECK, y eso&lt;br&gt;se desvía del criterio de la sección 5&lt;br&gt;—que dice catálogo solo si el negocio&lt;br&gt;agrega valores—. Aquí los agrega el&lt;br&gt;PRODUCTO, no el negocio.&lt;br&gt;&lt;br&gt;La razón es otra: son 57 y crecen con&lt;br&gt;cada feature. Un CHECK obligaría a una&lt;br&gt;migración por cada aviso nuevo, sin&lt;br&gt;ganar nada a cambio.&lt;/i&gt;" vertex="1">
          <mxGeometry height="340" width="250" x="60" y="460" as="geometry" />
        </mxCell>
        <mxCell id="t-notif" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;notifications.notification&lt;/b&gt;&lt;br&gt;&lt;i&gt;una fila POR DESTINATARIO&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt;&lt;br&gt;user_id&lt;br&gt;notification_type_id&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#388E3C&quot;&gt;&lt;b&gt;— el contenido —&lt;/b&gt;&lt;/font&gt;&lt;br&gt;title · body&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#388E3C&quot;&gt;&lt;b&gt;— a qué apunta —&lt;/b&gt;&lt;/font&gt;&lt;br&gt;entity_type &lt;i&gt;(requisition, worker…)&lt;/i&gt;&lt;br&gt;entity_id &lt;i&gt;(SIN FK, a propósito)&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#388E3C&quot;&gt;&lt;b&gt;— el ciclo de vida —&lt;/b&gt;&lt;/font&gt;&lt;br&gt;created_at&lt;br&gt;pushed_at &lt;i&gt;(cuándo salió a FCM)&lt;/i&gt;&lt;br&gt;push_error &lt;i&gt;(si falló)&lt;/i&gt;&lt;br&gt;&lt;b&gt;read_at&lt;/b&gt; &lt;i&gt;(NULO = no leída)&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;UNA FILA POR DESTINATARIO, no una con&lt;br&gt;lista. El vault dice &quot;notifica&lt;br&gt;simultáneamente al Supervisor e Inspector&quot;:&lt;br&gt;un evento, dos personas, y cada quien&lt;br&gt;la lee en su momento.&lt;br&gt;&lt;br&gt;El vínculo con lo que notifica es&lt;br&gt;polimórfico y SIN llave foránea, igual&lt;br&gt;que el journal: con ON DELETE CASCADE,&lt;br&gt;borrar una requisición borraría los&lt;br&gt;avisos que ya recibió la gente.&lt;/i&gt;" vertex="1">
          <mxGeometry height="620" width="400" x="400" y="220" as="geometry" />
        </mxCell>
        <mxCell id="t-device" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;notifications.device&lt;/b&gt;&lt;br&gt;&lt;i&gt;a dónde se manda el push&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt;&lt;br&gt;user_id&lt;br&gt;fcm_token&lt;br&gt;platform &lt;i&gt;(WEB | ANDROID | IOS)&lt;/i&gt;&lt;br&gt;last_seen_at&lt;br&gt;revoked_at&lt;br&gt;created_at&lt;br&gt;&lt;br&gt;&lt;i&gt;Una persona puede tener VARIOS&lt;br&gt;dispositivos: el teléfono y la laptop.&lt;br&gt;Por eso es tabla y no una columna en&lt;br&gt;identity.user.&lt;br&gt;&lt;br&gt;El token de FCM &lt;b&gt;rota&lt;/b&gt;: Firebase lo&lt;br&gt;renueva solo. Por eso el token es único&lt;br&gt;pero el dispositivo no se borra al&lt;br&gt;cerrar sesión — se marca revoked_at, y&lt;br&gt;así queda el rastro de desde dónde&lt;br&gt;entró esa persona.&lt;/i&gt;" vertex="1">
          <mxGeometry height="400" width="400" x="870" y="220" as="geometry" />
        </mxCell>
        <mxCell id="n-pubsub" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;Quién escribe estas filas&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Estructura de Proyecto&lt;/i&gt; declara el módulo como &lt;b&gt;consumidor de eventos de Pub/Sub&lt;/b&gt;. O sea que nadie llama al servicio de notificaciones directamente: los módulos publican lo que pasó y este las genera.&lt;br&gt;&lt;br&gt;Eso tiene una consecuencia directa en el modelo: &lt;b&gt;Pub/Sub garantiza entrega al menos una vez&lt;/b&gt;, no exactamente una. El mismo evento puede llegar dos veces y hay que poder distinguir el reintento del aviso legítimo.&lt;br&gt;&lt;br&gt;Lo resuelve el único de la restricción 2, sobre &lt;font face=&quot;Courier New&quot;&gt;(user_id, tipo, entidad)&lt;/font&gt;: el segundo intento choca contra el primero en vez de duplicar el aviso.&lt;br&gt;&lt;br&gt;&lt;i&gt;Sin eso, un reintento le manda dos veces el mismo push a la misma persona.&lt;/i&gt;" vertex="1">
          <mxGeometry height="340" width="400" x="870" y="660" as="geometry" />
        </mxCell>
        <mxCell id="n-noreten" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;Por qué NO se particiona, y el journal sí&lt;/b&gt;&lt;br&gt;&lt;br&gt;A primera vista son la misma forma —muchas filas, ordenadas por fecha— pero se comportan al revés.&lt;br&gt;&lt;br&gt;El &lt;font face=&quot;Courier New&quot;&gt;journal&lt;/font&gt; está &lt;b&gt;particionado por mes&lt;/b&gt; porque se retiene 24 meses y &lt;b&gt;nunca se borra&lt;/b&gt;: hay que poder desprender una partición vieja de golpe.&lt;br&gt;&lt;br&gt;Aquí &lt;b&gt;sí se borra&lt;/b&gt;: las leídas a los 30 días. Un &lt;font face=&quot;Courier New&quot;&gt;DELETE&lt;/font&gt; periódico sobre el índice de &lt;font face=&quot;Courier New&quot;&gt;read_at&lt;/font&gt; alcanza, y la tabla se mantiene chica sola.&lt;br&gt;&lt;br&gt;Volumen esperado: 5,000 colaboradores × ~3 avisos por semana ≈ &lt;b&gt;780,000 filas al año&lt;/b&gt;, pero con la retención el estado estable es mucho menor — solo lo de 30 días más el acumulado de no leídas.&lt;br&gt;&lt;br&gt;&lt;i&gt;Si algún día las no leídas se acumularan de verdad, la señal sería que nadie abre la app — y eso es un problema de producto, no de base de datos.&lt;/i&gt;" vertex="1">
          <mxGeometry height="240" width="860" x="400" y="880" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="e-user" target="t-notif" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;fontSize=10;" value="1:N  solo ve las propias">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="t-type" target="t-notif" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;fontSize=10;" value="1:N">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="e-user" target="t-device" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;fontSize=10;" value="1:N  varios dispositivos">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="nt2" name="2 - Decisiones y huecos">
    <mxGraphModel dx="862" dy="608" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="930" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=8;fontSize=13;" value="&lt;b&gt;Las decisiones, y lo que este esquema no resuelve&lt;/b&gt;&lt;br&gt;Qué se guarda, por qué el journal no sirve para esto, y los dos huecos que quedan." vertex="1">
          <mxGeometry height="80" width="1000" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="n2-vs" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;1 · Por qué el journal no sirve para esto&lt;/b&gt;&lt;br&gt;&lt;br&gt;Al extraer el catálogo apareció un patrón: casi toda notificación del vault viene junto a un &lt;i&gt;&quot;+ Registra en log&quot;&lt;/i&gt;. Son &lt;b&gt;hermanas&lt;/b&gt;, y la tentación es fusionarlas. No se puede:&lt;br&gt;&lt;br&gt;&lt;table border=&quot;1&quot; cellpadding=&quot;4&quot;&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;journal&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;notification&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;qué pasó&lt;/td&gt;&lt;td&gt;quién debe saberlo&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;INMUTABLE&lt;/td&gt;&lt;td&gt;cambia: read_at&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;una fila por evento&lt;/td&gt;&lt;td&gt;una por destinatario&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;24 meses&lt;/td&gt;&lt;td&gt;30 días si se leyó&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;REVOKE UPDATE&lt;/td&gt;&lt;td&gt;la app la actualiza&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;La quinta fila es la que cierra la discusión: el journal tiene &lt;font face=&quot;Courier New&quot;&gt;REVOKE UPDATE, DELETE&lt;/font&gt; sobre &lt;font face=&quot;Courier New&quot;&gt;app_user&lt;/font&gt; para que RR-16 se sostenga. Una notificación &lt;b&gt;tiene&lt;/b&gt; que poder marcarse como leída.&lt;br&gt;&lt;br&gt;&lt;i&gt;Meterlas en la misma tabla obligaría a levantar ese REVOKE — y con él, la garantía de que la bitácora es inmutable.&lt;/i&gt;" vertex="1">
          <mxGeometry height="420" width="640" x="40" y="130" as="geometry" />
        </mxCell>
        <mxCell id="n2-quien" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;2 · El destinatario es una persona, no un rol&lt;/b&gt;&lt;br&gt;&lt;br&gt;El catálogo dice cosas como &lt;i&gt;&quot;notifica al Manager de Área&quot;&lt;/i&gt;, y la tentación es guardar el &lt;b&gt;rol&lt;/b&gt; y resolver a quién en el momento de leer.&lt;br&gt;&lt;br&gt;No funciona, por dos razones:&lt;br&gt;&lt;br&gt;&lt;b&gt;a) El rol no identifica a una persona.&lt;/b&gt; Un hotel tiene varios Managers de Área —uno por departamento— y el aviso es para el del departamento afectado, no para todos.&lt;br&gt;&lt;br&gt;&lt;b&gt;b) &lt;font face=&quot;Courier New&quot;&gt;read_at&lt;/font&gt; es de una persona.&lt;/b&gt; Si la fila fuera del rol, ¿quién la marcó como leída? ¿Y sigue sin leer para los demás? Ahí ya no hay una fila, hay N.&lt;br&gt;&lt;br&gt;Así que el &lt;b&gt;fan-out ocurre al escribir&lt;/b&gt;: el servicio resuelve el rol a personas concretas y crea una fila para cada una.&lt;br&gt;&lt;br&gt;&lt;i&gt;Consecuencia asumida: si alguien cambia de rol después, sus avisos viejos se quedan con él. Es lo correcto — se los mandaron a él.&lt;/i&gt;" vertex="1">
          <mxGeometry height="420" width="640" x="700" y="130" as="geometry" />
        </mxCell>
        <mxCell id="n2-huecos" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;Los dos huecos que quedan&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;a) &quot;Notifica a involucrados&quot; sin lista.&lt;/b&gt; Aparece en dos lugares, y solo uno aclara quiénes: RF-30 dice &lt;i&gt;&quot;Líder, Reclutadora, Inspector, hotel&quot;&lt;/i&gt;; en &lt;i&gt;09 - Campos de formulario&lt;/i&gt; queda suelto. Se puede sembrar con la lista de RF-30, pero conviene confirmarla antes de que el servicio la codifique.&lt;br&gt;&lt;br&gt;&lt;b&gt;b) &lt;font face=&quot;Courier New&quot;&gt;PUNCH_REMINDER&lt;/font&gt; no tiene regla de disparo.&lt;/b&gt; RF-C-09 lo lista entre los tipos con un &lt;i&gt;&quot;(si aplica)&quot;&lt;/i&gt; entre paréntesis, y nada más. Falta la hora y la condición: ¿se manda si no ha ponchado 15 minutos después de su turno? ¿Solo si tiene turno planeado ese día? Es lo único del catálogo que &lt;b&gt;no se puede implementar&lt;/b&gt; tal como está.&lt;br&gt;&lt;br&gt;&lt;b&gt;Y una contradicción menor:&lt;/b&gt; &lt;i&gt;Estructura de Proyecto&lt;/i&gt; describe el módulo como &lt;i&gt;&quot;push FCM · &lt;b&gt;emails&lt;/b&gt;&quot;&lt;/i&gt;, pero el canal se decidió como &lt;b&gt;solo push&lt;/b&gt; el 2026-08-18. Ese renglón hay que corregirlo, o el correo hay que decidirlo." vertex="1">
          <mxGeometry height="300" width="1300" x="40" y="580" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="nt3" name="3 - Restricciones que sostienen el modelo">
    <mxGraphModel dx="862" dy="608" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1514" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=8;fontSize=13;" value="&lt;b&gt;Las restricciones que sostienen el modelo&lt;/b&gt;&lt;br&gt;Pocas: aquí lo que se defiende no es dinero, es que nadie reciba dos veces el mismo aviso ni deje de recibir uno." vertex="1">
          <mxGeometry height="80" width="1000" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="r1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;1 · Un token de FCM apunta a un solo usuario&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#1A5276&quot;&gt;CREATE UNIQUE INDEX ux_device_token&lt;br&gt;&amp;#160;&amp;#160;ON notifications.device (fcm_token)&lt;br&gt;&amp;#160;&amp;#160;WHERE revoked_at IS NULL;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Si dos usuarios comparten token, uno recibe los push del otro — y en un telefono prestado eso es justo lo que pasa al cambiar de sesion sin revocar. Es PARCIAL porque el token rota: el viejo se revoca y el mismo valor puede volver a asignarse despues.&lt;/i&gt;" vertex="1">
          <mxGeometry height="203" width="1280" x="40" y="130" as="geometry" />
        </mxCell>
        <mxCell id="r2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;2 · El mismo evento no genera dos avisos&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#1A5276&quot;&gt;CREATE UNIQUE INDEX ux_notification_event&lt;br&gt;&amp;#160;&amp;#160;ON notifications.notification&lt;br&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160; (user_id, notification_type_id, entity_type, entity_id)&lt;br&gt;&amp;#160;&amp;#160;WHERE entity_id IS NOT NULL;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Es la idempotencia. Pub/Sub entrega AL MENOS UNA VEZ, asi que el mismo evento puede llegar dos veces; sin este unico, el reintento le manda dos push identicos a la misma persona. Es PARCIAL porque hay avisos genericos sin entidad — y esos si pueden repetirse.&lt;/i&gt;" vertex="1">
          <mxGeometry height="217" width="1280" x="40" y="353" as="geometry" />
        </mxCell>
        <mxCell id="r3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;3 · Push fallido deja rastro, y no se pierde&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#1A5276&quot;&gt;ALTER TABLE notifications.notification&lt;br&gt;&amp;#160;&amp;#160;ADD CONSTRAINT ck_notification_push CHECK (&lt;br&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;push_error IS NULL OR pushed_at IS NOT NULL);&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Si hubo error, hubo intento. La fila se queda igual aunque el push falle: la notificacion sigue apareciendo en la lista de la app, que es la garantia real — el push es el aviso, la lista es el registro.&lt;/i&gt;" vertex="1">
          <mxGeometry height="189" width="1280" x="40" y="590" as="geometry" />
        </mxCell>
        <mxCell id="r4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;4 · No se puede leer antes de existir&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#1A5276&quot;&gt;ALTER TABLE notifications.notification&lt;br&gt;&amp;#160;&amp;#160;ADD CONSTRAINT ck_notification_read CHECK (&lt;br&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;read_at IS NULL OR read_at &amp;gt;= created_at);&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Atrapa el reloj mal puesto y el dato migrado a mano. Barato, y evita que un reporte de &quot;tiempo hasta leer&quot; arroje negativos.&lt;/i&gt;" vertex="1">
          <mxGeometry height="175" width="1280" x="40" y="799" as="geometry" />
        </mxCell>
        <mxCell id="r5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;5 · El indice que sostiene la pantalla&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#1A5276&quot;&gt;CREATE INDEX ix_notification_user_unread&lt;br&gt;&amp;#160;&amp;#160;ON notifications.notification (user_id, created_at DESC)&lt;br&gt;&amp;#160;&amp;#160;WHERE read_at IS NULL;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;RF-C-09 pide dos cosas: la lista ordenada por fecha descendente y un BADGE con el contador de no leidas. El badge se consulta en cada apertura de la app, asi que el indice es parcial sobre las no leidas — que son pocas — en vez de recorrer todo el historial.&lt;/i&gt;" vertex="1">
          <mxGeometry height="203" width="1280" x="40" y="994" as="geometry" />
        </mxCell>
        <mxCell id="r6" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;6 · La retencion, que la base no aplica sola&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#1A5276&quot;&gt;-- Job diario:&lt;br&gt;DELETE FROM notifications.notification&lt;br&gt; WHERE read_at IS NOT NULL&lt;br&gt;&amp;#160;&amp;#160; AND read_at &amp;lt; now() - interval '30 days';&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Las NO leidas nunca se borran, y eso es deliberado: borrar un aviso que nadie vio haria cierto el &quot;no me llego&quot;. Postgres no tiene retencion automatica, asi que es un job — y si el job deja de correr, la tabla crece en silencio. Conviene una alerta por tamano, no solo por error.&lt;/i&gt;" vertex="1">
          <mxGeometry height="217" width="1280" x="40" y="1217" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

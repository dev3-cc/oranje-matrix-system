<mxfile host="Electron" agent="Claude" pages="3">
  <diagram id="pg1" name="1 - ER con cardinalidades">
    <mxGraphModel dx="862" dy="608" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="tit" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=4;fontSize=13;" value="&lt;b&gt;Demanda — Modelo de datos&lt;/b&gt;&lt;br&gt;El esquema &lt;font face=&quot;Courier New&quot;&gt;demand&lt;/font&gt;: la Requisición, sus Posiciones y el Slot. Mismo método que &quot;Ventas - Modelo de Datos v2&quot;: esta página es solo nombres y relaciones, los tipos y las restricciones están en la página 3.&lt;br&gt;Fuentes: &lt;i&gt;Core/Módulos/Requisicion/Requisición.md&lt;/i&gt; (los campos), &lt;i&gt;Modelo de Datos sección 3&lt;/i&gt;, y los tres semáforos de la requisición." vertex="1">
          <mxGeometry height="90" width="620" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="c-state" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#9E9E9E;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;catalogs.status_light_state&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt;&lt;br&gt;status_light_id&lt;br&gt;code · color · name&lt;br&gt;display_order · is_branch&lt;br&gt;&lt;br&gt;&lt;i&gt;Ya existe. La Requisición usa TRES&lt;br&gt;semáforos distintos, y los tres son&lt;br&gt;filas de esta misma tabla.&lt;/i&gt;" vertex="1">
          <mxGeometry height="200" width="250" x="80" y="220" as="geometry" />
        </mxCell>
        <mxCell id="c-pos" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;catalogs.position&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#B85C00&quot;&gt;vuelve con este diagrama&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt;&lt;br&gt;hotel_department_id&lt;br&gt;code · name&lt;br&gt;&lt;br&gt;&lt;i&gt;Housekeeper, Houseman, Chef…&lt;br&gt;Agrupada por departamento del hotel.&lt;br&gt;La lista NO es exhaustiva: el negocio&lt;br&gt;agrega posiciones sin avisar (sección 5).&lt;/i&gt;" vertex="1">
          <mxGeometry height="220" width="250" x="80" y="470" as="geometry" />
        </mxCell>
        <mxCell id="c-mod" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;catalogs.hiring_modality&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#B85C00&quot;&gt;vuelve con este diagrama&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt;&lt;br&gt;code · name&lt;br&gt;&lt;br&gt;&lt;i&gt;Tiempo completo · Medio tiempo&lt;br&gt;Temporal · Según solicitud&lt;/i&gt;" vertex="1">
          <mxGeometry height="170" width="250" x="80" y="740" as="geometry" />
        </mxCell>
        <mxCell id="c-eng" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;catalogs.english_level&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#B85C00&quot;&gt;vuelve con este diagrama&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt;&lt;br&gt;code · name · display_order&lt;br&gt;&lt;br&gt;&lt;i&gt;Básico · Intermedio · Avanzado&lt;br&gt;Conversacional. En la posición es una&lt;br&gt;PREFERENCIA, no un requisito.&lt;/i&gt;" vertex="1">
          <mxGeometry height="190" width="250" x="80" y="960" as="geometry" />
        </mxCell>
        <mxCell id="c-dept" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#9E9E9E;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;catalogs.hotel_department&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt;&lt;br&gt;code · name&lt;br&gt;&lt;br&gt;&lt;i&gt;Housekeeping · Alimentos&lt;br&gt;Mantenimiento · Front Desk&lt;/i&gt;" vertex="1">
          <mxGeometry height="150" width="250" x="80" y="1200" as="geometry" />
        </mxCell>
        <mxCell id="c-hotel" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#9E9E9E;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;commercial.hotel&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt;&lt;br&gt;name · zone_id&lt;br&gt;…&lt;br&gt;&lt;br&gt;&lt;i&gt;De Ventas. Solo un hotel en NARANJA&lt;br&gt;puede generar requisiciones (RR-V-08):&lt;br&gt;esa regla es guard del servicio, no FK.&lt;/i&gt;" vertex="1">
          <mxGeometry height="190" width="260" x="700" y="80" as="geometry" />
        </mxCell>
        <mxCell id="c-user" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#9E9E9E;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;identity.user&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt;&lt;br&gt;full_name · role_id&lt;br&gt;hotel_id · department_id&lt;br&gt;&lt;br&gt;&lt;i&gt;La cabecera guarda CUATRO papeles&lt;br&gt;distintos sobre esta tabla.&lt;/i&gt;" vertex="1">
          <mxGeometry height="170" width="250" x="1420" y="120" as="geometry" />
        </mxCell>
        <mxCell id="t-req" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;demand.requisition&lt;/b&gt;&lt;br&gt;&lt;i&gt;la cabecera&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt;&lt;br&gt;number &lt;i&gt;(AAAAMMDDHHMM + homoclave)&lt;/i&gt;&lt;br&gt;hotel_id&lt;br&gt;&lt;b&gt;status_light_state_id&lt;/b&gt;&lt;br&gt;status_light_id &lt;i&gt;(fijo: REQUISITION)&lt;/i&gt;&lt;br&gt;area_manager_user_id &lt;i&gt;(el GH responsable)&lt;/i&gt;&lt;br&gt;authorized_by · authorized_at&lt;br&gt;inspector_id &lt;i&gt;(por la zona del hotel, RR-13)&lt;/i&gt;&lt;br&gt;deleted_at&lt;br&gt;created_at · updated_at&lt;br&gt;created_by &lt;i&gt;(el Supervisor)&lt;/i&gt; · updated_by&lt;br&gt;&lt;br&gt;&lt;i&gt;Los reclutadores NO están aquí: son&lt;br&gt;varios a la vez y viven en&lt;br&gt;coverage.participation (RR-15).&lt;/i&gt;" vertex="1">
          <mxGeometry height="400" width="340" x="700" y="402" as="geometry" />
        </mxCell>
        <mxCell id="t-pos" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;demand.position&lt;/b&gt;&lt;br&gt;&lt;i&gt;una posición solicitada&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt;&lt;br&gt;requisition_id&lt;br&gt;line_number &lt;i&gt;(el renglón dentro de la requisición)&lt;/i&gt;&lt;br&gt;catalog_position_id&lt;br&gt;hiring_modality_id&lt;br&gt;english_level_id &lt;i&gt;(opcional: es preferencia)&lt;/i&gt;&lt;br&gt;hotel_department_id&lt;br&gt;quantity&lt;br&gt;start_date &lt;i&gt;(sin fecha de fin, a propósito)&lt;/i&gt;&lt;br&gt;start_time &lt;i&gt;(la hora de entrada, tipo time)&lt;/i&gt;&lt;br&gt;notes&lt;br&gt;&lt;b&gt;coverage_state_id&lt;/b&gt; + coverage_light_id&lt;br&gt;&lt;b&gt;urgency_state_id&lt;/b&gt; + urgency_light_id&lt;br&gt;deleted_at&lt;br&gt;created_at · updated_at" vertex="1">
          <mxGeometry height="420" width="340" x="700" y="880" as="geometry" />
        </mxCell>
        <mxCell id="t-slot" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;demand.slot&lt;/b&gt;&lt;br&gt;&lt;i&gt;la unidad de bloqueo&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt;&lt;br&gt;position_id&lt;br&gt;ordinal&lt;br&gt;status &lt;i&gt;(free | taken — texto + CHECK)&lt;/i&gt;&lt;br&gt;created_at · updated_at&lt;br&gt;&lt;br&gt;&lt;i&gt;Una fila por cada persona solicitada:&lt;br&gt;quantity = 3 genera 3 slots.&lt;br&gt;Es lo que permite cumplir RR-15 sin&lt;br&gt;Redis — se bloquea la FILA DEL SLOT,&lt;br&gt;no la requisición.&lt;br&gt;&lt;br&gt;Sin deleted_at a propósito: si quantity&lt;br&gt;baja, el slot libre se borra físicamente&lt;br&gt;y el ocupado no se puede borrar.&lt;br&gt;Ver restricción 3.&lt;/i&gt;" vertex="1">
          <mxGeometry height="280" width="340" x="700" y="1380" as="geometry" />
        </mxCell>
        <mxCell id="t-hist" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;demand.requisition_state_history&lt;/b&gt;&lt;br&gt;&lt;i&gt;el timeline inmutable de la cabecera&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt;&lt;br&gt;requisition_id&lt;br&gt;from_state_id &lt;i&gt;(NULL en el primero)&lt;/i&gt;&lt;br&gt;to_state_id&lt;br&gt;reason_id &lt;i&gt;(opcional)&lt;/i&gt;&lt;br&gt;user_id&lt;br&gt;occurred_at&lt;br&gt;&lt;br&gt;&lt;i&gt;La nota de Requisición pide un &quot;timeline&lt;br&gt;cronológico inmutable con actor y&lt;br&gt;timestamp&quot;. Es D-14 aplicado.&lt;/i&gt;" vertex="1">
          <mxGeometry height="300" width="320" x="1420" y="480" as="geometry" />
        </mxCell>
        <mxCell id="n-ley" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F57C00;align=left;verticalAlign=top;spacing=10;fontSize=11;" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#B85C00&quot;&gt;■&lt;/font&gt; Catálogo que vuelve con este diagrama&lt;br&gt;■ Tabla de demand (esquema demand)&lt;br&gt;■ Tabla de otro módulo — demand no la crea&lt;br&gt;&lt;br&gt;PK y columnas clave en &lt;b&gt;negritas&lt;/b&gt;&lt;br&gt;Los &lt;i&gt;_id&lt;/i&gt; son claves foráneas&lt;br&gt;&lt;br&gt;&lt;b&gt;demand crea 4 tablas:&lt;/b&gt; requisition, position, slot y&lt;br&gt;requisition_state_history.&lt;br&gt;&lt;br&gt;&lt;b&gt;Y devuelve 3 catálogos&lt;/b&gt; que se habían quitado por no&lt;br&gt;tener consumidor: position, hiring_modality y&lt;br&gt;english_level. Ahora la Posición los usa." vertex="1">
          <mxGeometry height="300" width="320" x="1420" y="880" as="geometry" />
        </mxCell>
        <mxCell id="n-tres" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;align=left;verticalAlign=top;spacing=10;fontSize=11;" value="&lt;b&gt;Tres semáforos sobre las mismas dos filas&lt;/b&gt;&lt;br&gt;&lt;br&gt;La Requisición no tiene un estado, tiene tres — y cada uno mide&lt;br&gt;una dimensión distinta (regla de oro de los semáforos):&lt;br&gt;&lt;br&gt;&lt;b&gt;Semáforo de Requisición&lt;/b&gt; → vive en &lt;font face=&quot;Courier New&quot;&gt;requisition&lt;/font&gt;&lt;br&gt;Verde manzana · Verde · Amarillo · Azul claro · Rojo · Morado&lt;br&gt;El ciclo de vida de la cabecera.&lt;br&gt;&lt;br&gt;&lt;b&gt;Semáforo de Posiciones&lt;/b&gt; → vive en &lt;font face=&quot;Courier New&quot;&gt;position&lt;/font&gt;&lt;br&gt;Dorado · Naranja · Verde · Amarillo · Rojo · Morado&lt;br&gt;El % de cobertura de ESA posición.&lt;br&gt;&lt;br&gt;&lt;b&gt;Semáforo de Urgencia&lt;/b&gt; → vive en &lt;font face=&quot;Courier New&quot;&gt;position&lt;/font&gt;&lt;br&gt;Rojo (&amp;lt;72h) · Amarillo (72-120h) · Verde fuerte (&amp;gt;120h)&lt;br&gt;Derivado de authorized_at contra start_date.&lt;br&gt;&lt;br&gt;Por eso &lt;font face=&quot;Courier New&quot;&gt;position&lt;/font&gt; lleva DOS pares de columnas de estado: cada&lt;br&gt;par sostiene su propia FK compuesta contra el semáforo correcto.&lt;br&gt;Sin ese par, nada impide que la urgencia tome un color del&lt;br&gt;Semáforo de Posiciones." vertex="1">
          <mxGeometry height="420" width="420" x="1080" y="1380" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="c-hotel" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;fontSize=10;" target="t-req" value="1:N">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="c-state" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;fontSize=10;dashed=1;" target="t-req" value="1:N status_light_state_id">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="c-user" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;fontSize=10;dashed=1;" target="t-req" value="1:N cuatro papeles">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" source="t-req" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;fontSize=10;" target="t-pos" value="1:N una o más posiciones">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" edge="1" parent="1" source="c-pos" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;fontSize=10;dashed=1;" target="t-pos" value="1:N catalog_position_id">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" edge="1" parent="1" source="c-mod" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;fontSize=10;dashed=1;" target="t-pos" value="1:N hiring_modality_id">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" edge="1" parent="1" source="c-eng" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;fontSize=10;dashed=1;" target="t-pos" value="1:N english_level_id">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" edge="1" parent="1" source="c-dept" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;fontSize=10;dashed=1;" target="t-pos" value="1:N hotel_department_id">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" edge="1" parent="1" source="c-state" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;fontSize=10;dashed=1;" target="t-pos" value="1:N cobertura y urgencia">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" edge="1" parent="1" source="t-pos" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;fontSize=10;" target="t-slot" value="1:N quantity slots">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" edge="1" parent="1" source="t-req" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;fontSize=10;" target="t-hist" value="1:N un cambio por fila">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" edge="1" parent="1" source="c-state" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;fontSize=10;dashed=1;" target="t-hist" value="1:N from / to">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e13" edge="1" parent="1" source="c-user" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;fontSize=10;dashed=1;" target="t-hist" value="1:N user_id">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e14" edge="1" parent="1" source="c-dept" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;fontSize=10;dashed=1;" target="c-pos" value="1:N">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pg2" name="2 - Normalizacion y cardinalidades">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1700" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n-tit" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=4;fontSize=13;" value="&lt;b&gt;Normalización aplicada, y las decisiones que la rompen a propósito&lt;/b&gt;&lt;br&gt;Cada forma normal con el ejemplo concreto de este modelo." vertex="1">
          <mxGeometry height="60" width="900" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="n-1nf" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;align=left;verticalAlign=top;spacing=10;fontSize=11;" value="&lt;b&gt;1FN — sin grupos repetidos ni valores como columnas&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Las posiciones son filas, no columnas.&lt;/b&gt; La nota de Requisición&lt;br&gt;dice &quot;una cabecera y una o más posiciones&quot;. Con columnas&lt;br&gt;(posicion_1, posicion_2…) el límite lo pondría el esquema.&lt;br&gt;&lt;br&gt;&lt;b&gt;Los slots también son filas.&lt;/b&gt; Es la decisión central del modelo:&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;quantity = 3&lt;/font&gt; no es un contador, son 3 filas de &lt;font face=&quot;Courier New&quot;&gt;slot&lt;/font&gt;. Sin eso no&lt;br&gt;hay nada que bloquear y RR-15 no se puede cumplir.&lt;br&gt;&lt;br&gt;&lt;b&gt;Los tres semáforos son filas de catalogs&lt;/b&gt;, no enums ni columnas&lt;br&gt;de color. Agregar un estado es un INSERT (sección 5).&lt;br&gt;&lt;br&gt;&lt;b&gt;Y una nota de nomenclatura:&lt;/b&gt; ni la posición ni el slot usan una columna llamada &lt;i&gt;index&lt;/i&gt;. Modelo de Datos sección 3 la nombra así, pero en sección 2 de Estándares de Base de Datos &quot;índice&quot; es un objeto de base de datos con su propia convención (&lt;i&gt;ix_tabla_columnas&lt;/i&gt;), y en el ORM se leería como el índice de un arreglo. Son &lt;b&gt;line_number&lt;/b&gt; —la posición es un renglón de la requisición, como una partida de factura— y &lt;b&gt;ordinal&lt;/b&gt; —el slot es el enésimo de su posición—." vertex="1">
          <mxGeometry height="300" width="470" x="40" y="100" as="geometry" />
        </mxCell>
        <mxCell id="n-2nf" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;align=left;verticalAlign=top;spacing=10;fontSize=11;" value="&lt;b&gt;2FN — todo dato depende de la clave completa&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ninguna tabla de este esquema tiene clave compuesta natural, así&lt;br&gt;que la 2FN se cumple sola. Pero hay una tentación que sí la&lt;br&gt;rompería:&lt;br&gt;&lt;br&gt;&lt;b&gt;No guardar el nombre del hotel en position.&lt;/b&gt; Dependería de&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;requisition.hotel_id&lt;/font&gt;, no de la posición. Se llega por&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;position → requisition → hotel&lt;/font&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;Ni el nombre de la posición en slot.&lt;/b&gt; Depende de&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;position.catalog_position_id&lt;/font&gt;, dos saltos arriba." vertex="1">
          <mxGeometry height="300" width="470" x="540" y="100" as="geometry" />
        </mxCell>
        <mxCell id="n-3nf" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;align=left;verticalAlign=top;spacing=10;fontSize=11;" value="&lt;b&gt;3FN — sin dependencias transitivas&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;position&lt;/font&gt; guarda &lt;font face=&quot;Courier New&quot;&gt;catalog_position_id&lt;/font&gt;, no el texto &quot;Housekeeper&quot;.&lt;br&gt;Renombrar una posición del catálogo es un UPDATE en una fila.&lt;br&gt;&lt;br&gt;&lt;b&gt;Y una que parece violación y no lo es:&lt;/b&gt; &lt;font face=&quot;Courier New&quot;&gt;position&lt;/font&gt; tiene&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;hotel_department_id&lt;/font&gt; aunque &lt;font face=&quot;Courier New&quot;&gt;catalogs.position&lt;/font&gt; ya pertenece a un&lt;br&gt;departamento. No es redundancia — es que el hotel puede pedir un&lt;br&gt;Housekeeper para Alimentos. El departamento de la POSICIÓN&lt;br&gt;SOLICITADA es un dato del negocio, no del catálogo.&lt;br&gt;&lt;br&gt;&lt;i&gt;Si algún día se decide que siempre coinciden, la columna se va y&lt;br&gt;se deriva del catálogo. Hoy el vault no lo dice.&lt;/i&gt;" vertex="1">
          <mxGeometry height="330" width="470" x="40" y="430" as="geometry" />
        </mxCell>
        <mxCell id="n-denorm" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;align=left;verticalAlign=top;spacing=10;fontSize=11;" value="&lt;b&gt;Cuatro desnormalizaciones deliberadas&lt;/b&gt;&lt;br&gt;&lt;br&gt;Romper la regla sin decirlo es deuda; a propósito y por escrito es&lt;br&gt;diseño.&lt;br&gt;&lt;br&gt;&lt;b&gt;1. requisition.status_light_id&lt;/b&gt; — redundante, se deduce del estado.&lt;br&gt;Existe para que la FK compuesta impida que una requisición tome un&lt;br&gt;estado de otro semáforo. Mismo patrón que en Ventas.&lt;br&gt;&lt;br&gt;&lt;b&gt;2 y 3. position.coverage_light_id y urgency_light_id&lt;/b&gt; — igual, uno&lt;br&gt;por cada semáforo que la posición carga.&lt;br&gt;&lt;br&gt;&lt;b&gt;4. position.urgency_state_id&lt;/b&gt; — &lt;b&gt;es derivada&lt;/b&gt;: sale de&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;authorized_at&lt;/font&gt; contra &lt;font face=&quot;Courier New&quot;&gt;start_date&lt;/font&gt; con la fórmula de RR-H-05. Se&lt;br&gt;guarda porque un job de Cloud Scheduler la recalcula y las pantallas&lt;br&gt;la filtran; calcularla en cada consulta obligaría a repetir la&lt;br&gt;fórmula en cada lugar que la lea.&lt;br&gt;&lt;br&gt;&lt;i&gt;La cobertura (coverage_state_id) también es derivable —de contar&lt;br&gt;slots ocupados— y por la misma razón se guarda.&lt;/i&gt;" vertex="1">
          <mxGeometry height="400" width="470" x="540" y="430" as="geometry" />
        </mxCell>
        <mxCell id="n-card" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#5E35B1;align=left;verticalAlign=top;spacing=10;fontSize=11;" value="&lt;b&gt;Cardinalidades — por qué cada una es la que es&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1:N&lt;/b&gt; hotel → requisition&lt;br&gt;&lt;b&gt;1:N&lt;/b&gt; requisition → position &lt;i&gt;(una o más)&lt;/i&gt;&lt;br&gt;&lt;b&gt;1:N&lt;/b&gt; position → slot &lt;i&gt;(exactamente quantity)&lt;/i&gt;&lt;br&gt;&lt;b&gt;1:N&lt;/b&gt; requisition → requisition_state_history&lt;br&gt;&lt;b&gt;1:N&lt;/b&gt; catalogs.position → position&lt;br&gt;&lt;b&gt;1:N&lt;/b&gt; hiring_modality → position&lt;br&gt;&lt;b&gt;1:N&lt;/b&gt; english_level → position &lt;i&gt;(opcional)&lt;/i&gt;&lt;br&gt;&lt;b&gt;1:N&lt;/b&gt; hotel_department → position&lt;br&gt;&lt;b&gt;1:N&lt;/b&gt; hotel_department → catalogs.position&lt;br&gt;&lt;b&gt;1:N&lt;/b&gt; status_light_state → requisition, position (×2), history (×2)&lt;br&gt;&lt;b&gt;1:N&lt;/b&gt; user → requisition &lt;i&gt;(cuatro papeles distintos)&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Por qué la cabecera NO es N:M con user&lt;/b&gt;&lt;br&gt;Tiene cuatro papeles —quién la creó, el GH responsable, quién&lt;br&gt;autorizó y el Inspector— y cada uno es UNA persona. Son cuatro&lt;br&gt;columnas, no un puente. El único vínculo N:M con usuarios son los&lt;br&gt;reclutadores, y ese vive en &lt;font face=&quot;Courier New&quot;&gt;coverage.participation&lt;/font&gt; porque varios&lt;br&gt;trabajan la misma requisición a la vez (RR-15).&lt;br&gt;&lt;br&gt;&lt;b&gt;Por qué slot no apunta al Colaborador&lt;/b&gt;&lt;br&gt;El slot es el lugar; quién lo ocupa es la Asignación, y vive en&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;coverage&lt;/font&gt;. Mezclarlos haría que liberar a alguien borre el lugar.&lt;br&gt;&lt;br&gt;&lt;i&gt;Regla para decidir: si la fila tiene datos que solo aplican a una&lt;br&gt;de las dos partes, es 1:N.&lt;/i&gt;" vertex="1">
          <mxGeometry height="730" width="470" x="1040" y="100" as="geometry" />
        </mxCell>
        <mxCell id="n-fuera" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F57C00;align=left;verticalAlign=top;spacing=10;fontSize=11;" value="&lt;b&gt;Lo que este esquema NO trae, y dónde vive&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;La Asignación y el Self-Pick&lt;/b&gt; → esquema &lt;font face=&quot;Courier New&quot;&gt;coverage&lt;/font&gt;. El slot se&lt;br&gt;ocupa desde ahí, en la misma transacción (D-01).&lt;br&gt;&lt;br&gt;&lt;b&gt;El Schedule y el Timesheet&lt;/b&gt; → &lt;font face=&quot;Courier New&quot;&gt;operations&lt;/font&gt;. Nacen cuando el slot&lt;br&gt;se ocupa, no cuando se pide.&lt;br&gt;&lt;br&gt;&lt;b&gt;Historia del Semáforo de Posiciones&lt;/b&gt; → no se modela. Su estado es&lt;br&gt;derivado de contar slots, así que su historia se reconstruye de la&lt;br&gt;historia de asignaciones. Es la excepción razonada a D-14, no un&lt;br&gt;olvido.&lt;br&gt;&lt;br&gt;&lt;b&gt;El horario como estructura&lt;/b&gt; → hoy es texto. Ver pendiente 1." vertex="1">
          <mxGeometry height="300" width="470" x="40" y="790" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pg3" name="3 - Restricciones que sostienen el modelo">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1700" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="d-tit" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=4;fontSize=13;" value="&lt;b&gt;Las restricciones, en SQL&lt;/b&gt;&lt;br&gt;Principio rector de Estándares de Base de Datos: toda regla que pueda vivir como restricción, vive ahí." vertex="1">
          <mxGeometry height="60" width="980" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="d-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;align=left;verticalAlign=top;spacing=10;fontSize=11;" value="&lt;b&gt;1. El slot es la unidad de bloqueo — RR-15&lt;/b&gt;&lt;br&gt;&lt;br&gt;No es una restricción, es la consulta que hace innecesario Redis:&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;BEGIN;&lt;br&gt;  SELECT id FROM demand.slot&lt;br&gt;   WHERE position_id = $1 AND status = &#39;free&#39;&lt;br&gt;   ORDER BY ordinal&lt;br&gt;   LIMIT 1&lt;br&gt;   FOR UPDATE SKIP LOCKED;&lt;br&gt;&lt;br&gt;  INSERT INTO coverage.assignment (...);&lt;br&gt;  UPDATE demand.slot SET status = &#39;taken&#39; WHERE id = $slot;&lt;br&gt;  -- recalcular cobertura y estado de la requisición&lt;br&gt;  INSERT INTO journal.journal (...);&lt;br&gt;COMMIT;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Gana el primero; el segundo ve otro slot o ninguno, y nadie&lt;br&gt;queda esperando. Los cinco pasos van en UNA transacción (D-01).&lt;/i&gt;" vertex="1">
          <mxGeometry height="400" width="490" x="40" y="100" as="geometry" />
        </mxCell>
        <mxCell id="d-2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;align=left;verticalAlign=top;spacing=10;fontSize=11;" value="&lt;b&gt;2. Una posición no puede tomar el estado de otro semáforo&lt;/b&gt;&lt;br&gt;&lt;br&gt;La Posición carga DOS semáforos, así que son dos FK compuestas:&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;ALTER TABLE demand.position&lt;br&gt;  ADD CONSTRAINT fk_position_coverage_state&lt;br&gt;    FOREIGN KEY (coverage_state_id, coverage_light_id)&lt;br&gt;    REFERENCES catalogs.status_light_state (id, status_light_id),&lt;br&gt;  ADD CONSTRAINT fk_position_urgency_state&lt;br&gt;    FOREIGN KEY (urgency_state_id, urgency_light_id)&lt;br&gt;    REFERENCES catalogs.status_light_state (id, status_light_id);&lt;/font&gt;&lt;br&gt;&lt;br&gt;Y la cabecera lleva la suya contra el Semáforo de Requisición.&lt;br&gt;&lt;br&gt;&lt;i&gt;Sin esto, un UPDATE mal escrito deja la urgencia en &quot;Dorado&quot; —un&lt;br&gt;color del Semáforo de Posiciones— y ninguna consulta se queja.&lt;/i&gt;" vertex="1">
          <mxGeometry height="400" width="490" x="560" y="100" as="geometry" />
        </mxCell>
        <mxCell id="d-3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;align=left;verticalAlign=top;spacing=10;fontSize=11;" value="&lt;b&gt;3. El número de posición y el de slot son únicos donde importa&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;CREATE UNIQUE INDEX ux_position_requisition_line&lt;br&gt;  ON demand.position (requisition_id, line_number)&lt;br&gt;  WHERE deleted_at IS NULL;&lt;br&gt;&lt;br&gt;CREATE UNIQUE INDEX ux_slot_position_ordinal&lt;br&gt;  ON demand.slot (position_id, ordinal);&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;El de posición va PARCIAL porque la requisición usa borrado&lt;br&gt;lógico: un UNIQUE normal impediría reusar el número 2 después de&lt;br&gt;eliminar esa posición. Es el error más común de este patrón y&lt;br&gt;aparece meses después, en producción (sección 4).&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Y el del slot NO es parcial, porque el slot no lleva deleted_at.&lt;/b&gt;&lt;br&gt;Su política de borrado es:&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;-- si quantity baja de 3 a 2, el slot 3:&lt;br&gt;DELETE FROM demand.slot&lt;br&gt;&amp;nbsp;WHERE id = $1 AND status = 'free';&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Borrado &lt;b&gt;físico&lt;/b&gt;, y solo si está libre. Un slot libre nunca tuvo a nadie: no hay historia que conservar, y su rastro queda en el journal.&lt;br&gt;&lt;br&gt;Si está ocupado, la FK de &lt;b&gt;coverage.assignment.slot_id&lt;/b&gt; con ON DELETE RESTRICT lo impide — y eso es lo correcto: el servicio tiene que liberar la asignación primero. La regla no vive en el código, la hace cumplir el motor.&lt;/i&gt;" vertex="1">
          <mxGeometry height="380" width="490" x="40" y="530" as="geometry" />
        </mxCell>
        <mxCell id="d-4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;align=left;verticalAlign=top;spacing=10;fontSize=11;" value="&lt;b&gt;4. Coherencia dentro de la propia fila&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;ck_requisition_authorized_completo&lt;br&gt;  CHECK ((authorized_by IS NULL AND authorized_at IS NULL)&lt;br&gt;      OR (authorized_by IS NOT NULL AND authorized_at IS NOT NULL))&lt;br&gt;&lt;br&gt;ck_position_quantity_positiva&lt;br&gt;  CHECK (quantity &amp;gt; 0)&lt;br&gt;&lt;br&gt;ck_slot_status&lt;br&gt;  CHECK (status IN (&#39;free&#39;, &#39;taken&#39;))&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;El status del slot es lista cerrada y técnica: el negocio no&lt;br&gt;agrega estados de ocupación. Va como CHECK, no como catálogo (sección 5).&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;quantity &amp;gt; 0 no es cosmético: quantity = 0 generaría cero slots&lt;br&gt;y una posición que nadie puede cubrir jamás.&lt;/i&gt;" vertex="1">
          <mxGeometry height="360" width="490" x="560" y="530" as="geometry" />
        </mxCell>
        <mxCell id="d-5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;align=left;verticalAlign=top;spacing=10;fontSize=11;" value="&lt;b&gt;5. Índices, con la consulta que los justifica&lt;/b&gt;&lt;br&gt;&lt;br&gt;sección 7 exige que todo índice se pueda defender con una consulta:&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;ix_requisition_hotel_state (hotel_id, status_light_state_id)&lt;br&gt;  -- El tablero del hotel: sus requisiciones por estado&lt;br&gt;&lt;br&gt;ix_position_requisition (requisition_id)&lt;br&gt;  -- Abrir una requisición trae todas sus posiciones&lt;br&gt;&lt;br&gt;ix_slot_position_free (position_id) WHERE status = &#39;free&#39;&lt;br&gt;  -- EL indice del Self-Pick. Parcial a proposito: solo los&lt;br&gt;  -- libres se buscan, y son los menos&lt;br&gt;&lt;br&gt;ix_position_urgency (urgency_state_id)&lt;br&gt;  -- La cola de Reclutamiento ordenada por urgencia&lt;br&gt;&lt;br&gt;ix_requisition_history (requisition_id, occurred_at DESC)&lt;br&gt;  -- El timeline de la cabecera&lt;/font&gt;" vertex="1">
          <mxGeometry height="400" width="490" x="1080" y="100" as="geometry" />
        </mxCell>
        <mxCell id="d-6" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F57C00;align=left;verticalAlign=top;spacing=10;fontSize=11;" value="&lt;b&gt;6. Lo que NO se puede declarar, y por eso es guard del servicio&lt;/b&gt;&lt;br&gt;&lt;br&gt;Cruzan filas o tablas, así que viven en el servicio del módulo,&lt;br&gt;dentro de la transacción:&lt;br&gt;&lt;br&gt;&lt;b&gt;RR-V-08&lt;/b&gt; solo un hotel en NARANJA puede generar requisiciones. Es&lt;br&gt;un estado del ciclo comercial en otro esquema: no hay FK que lo&lt;br&gt;exprese.&lt;br&gt;&lt;br&gt;&lt;b&gt;RR-H-03&lt;/b&gt; no se autoriza una requisición sin al menos una posición.&lt;br&gt;Es un COUNT sobre la tabla hija.&lt;br&gt;&lt;br&gt;&lt;b&gt;quantity ↔ slots.&lt;/b&gt; Que existan exactamente &lt;font face=&quot;Courier New&quot;&gt;quantity&lt;/font&gt; slots por&lt;br&gt;posición no lo puede garantizar un CHECK: el servicio los crea al&lt;br&gt;autorizar, y si &lt;font face=&quot;Courier New&quot;&gt;quantity&lt;/font&gt; cambia, los ajusta.&lt;br&gt;&lt;br&gt;&lt;b&gt;La fórmula de urgencia&lt;/b&gt; (RR-H-05) la aplica un job, no la base." vertex="1">
          <mxGeometry height="400" width="490" x="1080" y="530" as="geometry" />
        </mxCell>
        <mxCell id="d-7" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F57C00;align=left;verticalAlign=top;spacing=10;fontSize=11;" value="&lt;b&gt;Dos contradicciones del vault que este diagrama destapa&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1. &quot;Eliminada físicamente&quot; vs. borrado lógico.&lt;/b&gt;&lt;br&gt;El Semáforo de Requisición describe Morado como &lt;i&gt;&quot;Requisición&lt;br&gt;eliminada físicamente&quot;&lt;/i&gt;. Pero la sección 4 de Estándares de Base de Datos&lt;br&gt;pone a &lt;font face=&quot;Courier New&quot;&gt;requisition&lt;/font&gt; en la lista de &lt;font face=&quot;Courier New&quot;&gt;deleted_at&lt;/font&gt; — &lt;i&gt;&quot;nunca DELETE&lt;br&gt;físico&quot;&lt;/i&gt;. Y hay un argumento más fuerte que el estándar: &lt;b&gt;una fila&lt;br&gt;borrada físicamente no puede tener un estado&lt;/b&gt;. Si Morado existe como&lt;br&gt;color del semáforo, el borrado es lógico por definición.&lt;br&gt;&lt;br&gt;Este diagrama modela &lt;font face=&quot;Courier New&quot;&gt;deleted_at&lt;/font&gt;. La nota del semáforo debería&lt;br&gt;decir &quot;eliminada&quot; y no &quot;físicamente&quot; — y eso lo tiene que corregir&lt;br&gt;el semaforo-guardian, no yo.&lt;br&gt;&lt;br&gt;&lt;b&gt;2. El GH responsable y quién autoriza.&lt;/b&gt;&lt;br&gt;La cabecera lista &lt;i&gt;&quot;GH (Manager de Área) responsable&quot;&lt;/i&gt; como campo, y&lt;br&gt;el semáforo dice que autoriza &lt;i&gt;&quot;GM o GH&quot;&lt;/i&gt;. Pueden ser la misma&lt;br&gt;persona o no: un GM puede autorizar la requisición de un&lt;br&gt;departamento cuyo GH es otro. Modelé las dos columnas por separado&lt;br&gt;—&lt;font face=&quot;Courier New&quot;&gt;area_manager_user_id&lt;/font&gt; y &lt;font face=&quot;Courier New&quot;&gt;authorized_by&lt;/font&gt;— porque colapsarlas&lt;br&gt;perdería el dato. &lt;b&gt;Falta confirmarlo.&lt;/b&gt;" vertex="1">
          <mxGeometry height="330" width="1010" x="40" y="930" as="geometry" />
        </mxCell>
        <mxCell id="d-8" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F57C00;align=left;verticalAlign=top;spacing=10;fontSize=11;" value="&lt;b&gt;Pendientes antes de migrar&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1. La duración del turno, resuelta a medias.&lt;/b&gt;&lt;br&gt;La nota de Requisición pide &quot;Horario&quot; sin definir su forma. Se guarda&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;start_time time&lt;/font&gt; — solo la hora de entrada — y eso es una&lt;br&gt;&lt;b&gt;interpretación más estrecha&lt;/b&gt; que el campo del vault: un horario podría ser&lt;br&gt;&quot;7:00 a 15:30&quot;.&lt;br&gt;&lt;br&gt;&lt;b&gt;Por qué se narró así:&lt;/b&gt; quien necesita la duración es el Schedule, que&lt;br&gt;genera una entrada por día — y &lt;font face=&quot;Courier New&quot;&gt;operations&lt;/font&gt; no existe todavía.&lt;br&gt;Modelarla ahora sería para un consumidor que no está.&lt;br&gt;&lt;br&gt;&lt;b&gt;Qué decidir al diseñar operations:&lt;/b&gt; dónde vive la duración —en&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;position&lt;/font&gt;, en el Contrato o en el Schedule mismo—. El dato del negocio&lt;br&gt;es &lt;b&gt;8.5 horas brutas&lt;/b&gt; (8 netas tras los 30 min de lunch) y &lt;b&gt;varía&lt;/b&gt;.&lt;br&gt;&lt;br&gt;&lt;i&gt;Si se guarda, va en minutos enteros por la sección 3: 8.5 h son 510&lt;br&gt;minutos exactos y como decimal arrastra. Y ese formato no obliga a nadie&lt;br&gt;a teclear minutos: la UI muestra selectores de hora y la app calcula.&lt;br&gt;&lt;br&gt;Sin la duración no se puede calcular la hora de salida ni comparar lo&lt;br&gt;planeado contra lo ponchado.&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;2. El número de requisición.&lt;/b&gt; &lt;font face=&quot;Courier New&quot;&gt;AAAAMMDDHHMM&lt;/font&gt; + homoclave de 2&lt;br&gt;caracteres. ¿Quién genera la homoclave y contra qué se verifica que&lt;br&gt;no choque? Si es aleatoria necesita un UNIQUE y un reintento.&lt;br&gt;&lt;br&gt;&lt;b&gt;3. ¿Los slots se crean al autorizar o al crear la posición?&lt;/b&gt; Cambia&lt;br&gt;si &lt;font face=&quot;Courier New&quot;&gt;slot&lt;/font&gt; puede existir mientras la requisición está en Verde&lt;br&gt;manzana. Afecta el índice parcial del Self-Pick.&lt;br&gt;&lt;br&gt;&lt;b&gt;4. Si un colaborador sirve a dos departamentos&lt;/b&gt; la aprobación de&lt;br&gt;horas se parte (D-09, pendiente abierto). No bloquea a demand." vertex="1">
          <mxGeometry height="600" width="490" x="1080" y="930" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

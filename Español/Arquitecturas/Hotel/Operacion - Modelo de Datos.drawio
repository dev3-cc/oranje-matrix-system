<mxfile host="Electron" agent="Claude" pages="3">
  <diagram id="op1" name="1 - ER con cardinalidades">
    <mxGraphModel dx="862" dy="608" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="tit" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=8;fontSize=13;" value="&lt;b&gt;Operación — Modelo de datos&lt;/b&gt;&lt;br&gt;El esquema &lt;font face=&quot;Courier New&quot;&gt;operations&lt;/font&gt;: el Schedule, el Timesheet y el ponche. Mismo método que Ventas v2, Demanda y Colaborador: esta página es solo nombres y relaciones; los tipos y las restricciones están en la página 3.&lt;br&gt;Fuentes: &lt;i&gt;Schedule.md&lt;/i&gt;, &lt;i&gt;Timesheet.md&lt;/i&gt;, &lt;i&gt;Reglas de Negocio&lt;/i&gt; (mecanismo de ponchado, aprobación, overtime y deducción de lunch) y &lt;i&gt;Modelo de Datos sección 5&lt;/i&gt;.&lt;br&gt;&lt;b&gt;Aquí aterrizan tres cosas que los diagramas anteriores dejaron pendientes:&lt;/b&gt; RR-05, el cálculo del overtime y el contador de inasistencias." vertex="1">
          <mxGeometry height="140" width="880" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="leg" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;Cómo leer los colores&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#388E3C&quot;&gt;&lt;b&gt;Verde&lt;/b&gt;&lt;/font&gt; — esquema &lt;font face=&quot;Courier New&quot;&gt;operations&lt;/font&gt;, NUEVO. Cinco tablas.&lt;br&gt;&lt;b&gt;Gris&lt;/b&gt; — ya existe en la base y no se toca.&lt;br&gt;&lt;font color=&quot;#C62828&quot;&gt;&lt;b&gt;Rojo&lt;/b&gt;&lt;/font&gt; — una contradicción del vault o una regla que este diagrama no puede hacer cumplir.&lt;br&gt;&lt;br&gt;&lt;i&gt;La cadena completa del sistema queda cerrada con esto:&lt;/i&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;demand → coverage → operations → settlement&lt;/font&gt;" vertex="1">
          <mxGeometry height="140" width="680" x="960" y="20" as="geometry" />
        </mxCell>
        <mxCell id="e-hotel" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#9E9E9E;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;commercial.hotel&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt;&lt;br&gt;name · zone_id&lt;br&gt;…&lt;br&gt;&lt;br&gt;&lt;i&gt;El contrato del hotel define&lt;br&gt;inicio y fin de su semana.&lt;/i&gt;" vertex="1">
          <mxGeometry height="130" width="240" x="60" y="220" as="geometry" />
        </mxCell>
        <mxCell id="e-assign" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#9E9E9E;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;coverage.assignment&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt;&lt;br&gt;slot_id · worker_id&lt;br&gt;type · validity&lt;br&gt;status&lt;br&gt;&lt;br&gt;&lt;i&gt;El puente. De aquí sale TODO:&lt;br&gt;el colaborador, y por slot →&lt;br&gt;position → requisition,&lt;br&gt;que es lo que el overtime&lt;br&gt;necesita (D-10).&lt;/i&gt;" vertex="1">
          <mxGeometry height="200" width="240" x="60" y="380" as="geometry" />
        </mxCell>
        <mxCell id="e-worker" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#9E9E9E;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;personal.worker&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt;&lt;br&gt;full_name · …&lt;br&gt;&lt;br&gt;&lt;i&gt;No cuelga directo de aquí:&lt;br&gt;siempre vía assignment.&lt;/i&gt;" vertex="1">
          <mxGeometry height="130" width="240" x="60" y="610" as="geometry" />
        </mxCell>
        <mxCell id="e-req" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#9E9E9E;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;demand.requisition&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt;&lt;br&gt;number · hotel_id&lt;br&gt;…&lt;br&gt;&lt;br&gt;&lt;i&gt;El umbral de overtime se evalúa&lt;br&gt;POR REQUISICIÓN (D-10), no por&lt;br&gt;hotel ni global.&lt;/i&gt;" vertex="1">
          <mxGeometry height="150" width="240" x="60" y="770" as="geometry" />
        </mxCell>
        <mxCell id="e-user" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#9E9E9E;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;identity.user&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt;&lt;br&gt;full_name · role_id&lt;br&gt;&lt;br&gt;&lt;i&gt;Tres papeles distintos aquí:&lt;br&gt;quien revisa, quien aprueba&lt;br&gt;y quien registra un manual.&lt;/i&gt;" vertex="1">
          <mxGeometry height="150" width="240" x="60" y="950" as="geometry" />
        </mxCell>
        <mxCell id="t-sched" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;operations.schedule&lt;/b&gt;&lt;br&gt;&lt;i&gt;la semana del hotel&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt;&lt;br&gt;hotel_id&lt;br&gt;week_start · week_end&lt;br&gt;created_by&lt;br&gt;created_at · updated_at&lt;br&gt;&lt;br&gt;&lt;i&gt;Una fila por hotel y por semana. El&lt;br&gt;inicio y el fin NO son fijos: los define&lt;br&gt;el Contrato de cada hotel, así que se&lt;br&gt;guardan por semana y no se calculan.&lt;/i&gt;" vertex="1">
          <mxGeometry height="250" width="340" x="390" y="220" as="geometry" />
        </mxCell>
        <mxCell id="t-entry" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;operations.schedule_entry&lt;/b&gt;&lt;br&gt;&lt;i&gt;el turno PLANEADO de un día&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt;&lt;br&gt;schedule_id&lt;br&gt;assignment_id&lt;br&gt;work_date&lt;br&gt;&lt;b&gt;shift_range&lt;/b&gt; &lt;i&gt;(tstzrange: fecha Y hora)&lt;/i&gt;&lt;br&gt;created_at · updated_at&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#C62828&quot;&gt;&lt;b&gt;AQUÍ vive RR-05.&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;i&gt;La restricción de exclusión que no cabía&lt;br&gt;en coverage.assignment vive aquí, porque&lt;br&gt;esta es la primera tabla con HORAS reales:&lt;br&gt;&lt;br&gt;EXCLUDE USING gist (&lt;br&gt;&amp;#160;&amp;#160;worker_id WITH =,&lt;br&gt;&amp;#160;&amp;#160;shift_range WITH &amp;amp;&amp;amp;)&lt;br&gt;&lt;br&gt;Va sobre lo PLANEADO y no sobre los&lt;br&gt;ponches, porque el choque hay que&lt;br&gt;impedirlo al asignar — no descubrirlo&lt;br&gt;cuando el colaborador ya se presentó.&lt;/i&gt;" vertex="1">
          <mxGeometry height="420" width="340" x="390" y="510" as="geometry" />
        </mxCell>
        <mxCell id="t-ts" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;operations.timesheet&lt;/b&gt;&lt;br&gt;&lt;i&gt;la semana de UN colaborador en UNA requisición&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt;&lt;br&gt;schedule_id&lt;br&gt;worker_id&lt;br&gt;&lt;b&gt;requisition_id&lt;/b&gt;&lt;br&gt;week_start · week_end&lt;br&gt;status &lt;i&gt;(open | pending_approval | approved)&lt;/i&gt;&lt;br&gt;approved_by · approved_at&lt;br&gt;created_at · updated_at&lt;br&gt;&lt;br&gt;&lt;i&gt;Se rompe por REQUISICIÓN, no por hotel. Es lo&lt;br&gt;que D-10 exige: dos requisiciones del mismo&lt;br&gt;hotel evalúan su umbral de 40h por separado y&lt;br&gt;sus horas no se suman.&lt;br&gt;&lt;br&gt;Sin fecha límite de aprobación a propósito: el&lt;br&gt;plazo NO vence.&lt;/i&gt;" vertex="1">
          <mxGeometry height="330" width="360" x="800" y="220" as="geometry" />
        </mxCell>
        <mxCell id="t-day" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;operations.timesheet_day&lt;/b&gt;&lt;br&gt;&lt;i&gt;una jornada&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt;&lt;br&gt;timesheet_id&lt;br&gt;work_date&lt;br&gt;gross_minutes &lt;i&gt;(Salida − Entrada)&lt;/i&gt;&lt;br&gt;lunch_deduction_minutes &lt;i&gt;(30, siempre)&lt;/i&gt;&lt;br&gt;net_minutes &lt;i&gt;(GENERATED: bruto − lunch)&lt;/i&gt;&lt;br&gt;overtime_minutes&lt;br&gt;is_absence &lt;i&gt;(no se presentó)&lt;/i&gt;&lt;br&gt;has_anomaly · review_note&lt;br&gt;reviewed_by · reviewed_at &lt;i&gt;(el Supervisor)&lt;/i&gt;&lt;br&gt;created_at · updated_at&lt;br&gt;&lt;br&gt;&lt;i&gt;La deducción de lunch es de 30 min POR&lt;br&gt;JORNADA, SIEMPRE: haya o no marcas de lunch,&lt;br&gt;y sin importar cuánto duró en realidad. Es&lt;br&gt;constante, no cálculo.&lt;br&gt;&lt;br&gt;El par de lunch sí se mide —alimenta el&lt;br&gt;Indicador de Lunch Extendido— pero NO&lt;br&gt;toca el pago. Decisión deliberada.&lt;/i&gt;" vertex="1">
          <mxGeometry height="400" width="360" x="800" y="590" as="geometry" />
        </mxCell>
        <mxCell id="t-punch" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;operations.punch_mark&lt;/b&gt;&lt;br&gt;&lt;i&gt;la evidencia de presencia&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt;&lt;br&gt;timesheet_day_id&lt;br&gt;type &lt;i&gt;(CLOCK_IN | LUNCH_OUT |&lt;/i&gt;&lt;br&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;i&gt;LUNCH_IN | CLOCK_OUT)&lt;/i&gt;&lt;br&gt;&lt;i&gt;Solo las dos de los extremos son&lt;br&gt;OBLIGATORIAS; el par de lunch no.&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#388E3C&quot;&gt;&lt;b&gt;— el doble reloj —&lt;/b&gt;&lt;/font&gt;&lt;br&gt;device_at &lt;i&gt;(la hora del teléfono)&lt;/i&gt;&lt;br&gt;server_at &lt;i&gt;(cuando llegó al servidor)&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#388E3C&quot;&gt;&lt;b&gt;— la evidencia —&lt;/b&gt;&lt;/font&gt;&lt;br&gt;coordinates &lt;i&gt;(geography Point 4326)&lt;/i&gt;&lt;br&gt;inside_geofence &lt;i&gt;(validado al sincronizar)&lt;/i&gt;&lt;br&gt;photo_path &lt;i&gt;(Entrada y Salida)&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#388E3C&quot;&gt;&lt;b&gt;— la excepción —&lt;/b&gt;&lt;/font&gt;&lt;br&gt;is_manual · registered_by &lt;i&gt;(el Supervisor)&lt;/i&gt;&lt;br&gt;manual_reason&lt;br&gt;created_at&lt;br&gt;&lt;br&gt;&lt;i&gt;DOS relojes porque el ponche funciona sin señal:&lt;br&gt;la marca se guarda en el teléfono y se envía al&lt;br&gt;recuperar conexión. El desfase entre los dos es&lt;br&gt;justo lo que el Supervisor revisa como anómalo.&lt;br&gt;&lt;br&gt;Append-only: sin updated_at. Corregir un ponche&lt;br&gt;es registrar uno manual, no editar el original.&lt;/i&gt;" vertex="1">
          <mxGeometry height="480" width="380" x="1230" y="220" as="geometry" />
        </mxCell>
        <mxCell id="n-3v6" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;Cuatro marcas — el conflicto quedó resuelto&lt;/b&gt;&lt;br&gt;&lt;br&gt;El vault se contradecía: &lt;i&gt;Reglas de Negocio&lt;/i&gt; y &lt;i&gt;Timesheet.md&lt;/i&gt; decían &lt;b&gt;tres&lt;/b&gt; marcas; &lt;i&gt;Schedule.md&lt;/i&gt; seguía diciendo &lt;b&gt;seis&lt;/b&gt;. El 2026-08-13, con autorización del usuario, quedaron &lt;b&gt;cuatro&lt;/b&gt;.&lt;br&gt;&lt;br&gt;Lo que resolvió cada pieza:&lt;br&gt;&lt;br&gt;&lt;b&gt;· Vuelve el regreso de lunch&lt;/b&gt;, y con él el &lt;b&gt;Indicador de Lunch Extendido&lt;/b&gt;, que con tres marcas era literalmente incalculable — sin fin de comida no hay duración que comparar.&lt;br&gt;&lt;br&gt;&lt;b&gt;· Se eliminan los breaks.&lt;/b&gt; Se evaluó recuperar su par y se descartó: con la deducción fija no descuentan nada, así que serían dos marcas que nadie poncharía.&lt;br&gt;&lt;br&gt;&lt;b&gt;· La deducción sigue fija en 30 min&lt;/b&gt;, aunque ahora se conozca la duración real. El par de lunch alimenta el indicador —supervisión interna de Oranje— y &lt;b&gt;no&lt;/b&gt; el pago.&lt;br&gt;&lt;br&gt;&lt;i&gt;Consecuencia asumida: quien se toma 90 minutos cobra 60 de ellos. Y como el par es opcional, solo ponchan los cumplidos — el indicador ve menos de lo que busca.&lt;/i&gt;" vertex="1">
          <mxGeometry height="260" width="380" x="1230" y="730" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="e-hotel" target="t-sched" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;fontSize=10;" value="1:N  una por semana">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="t-sched" target="t-entry" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;fontSize=10;" value="1:N">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="e-assign" target="t-entry" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;fontSize=10;" value="1:N  un renglón por día">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" source="t-sched" target="t-ts" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;fontSize=10;" value="1:N">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" edge="1" parent="1" source="e-worker" target="t-ts" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;fontSize=10;dashed=1;" value="1:N">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" edge="1" parent="1" source="e-req" target="t-ts" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;fontSize=10;dashed=1;" value="1:N  el umbral de 40h">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" edge="1" parent="1" source="t-ts" target="t-day" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;fontSize=10;" value="1:N  una por jornada">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" edge="1" parent="1" source="t-day" target="t-punch" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;fontSize=10;" value="1:3  las tres marcas">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" edge="1" parent="1" source="e-user" target="t-day" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;fontSize=10;dashed=1;" value="1:N  revisa el Supervisor">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" edge="1" parent="1" source="e-user" target="t-ts" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;fontSize=10;dashed=1;" value="1:N  aprueba el Manager de Área">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="op2" name="2 - Calculo, aprobacion y deuda">
    <mxGraphModel dx="862" dy="608" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1030" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=8;fontSize=13;" value="&lt;b&gt;Cómo se calcula, quién aprueba, y lo que este esquema cierra&lt;/b&gt;&lt;br&gt;Las tres reglas que los diagramas anteriores dejaron esperando, y las decisiones que hicieron falta para modelarlas." vertex="1">
          <mxGeometry height="80" width="1000" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="n2-ot" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;1 · El overtime, por fin calculable&lt;/b&gt;&lt;br&gt;&lt;br&gt;El umbral son &lt;b&gt;40 horas brutas semanales por colaborador EN CADA REQUISICIÓN&lt;/b&gt; (D-10). Por eso &lt;font face=&quot;Courier New&quot;&gt;timesheet&lt;/font&gt; lleva &lt;font face=&quot;Courier New&quot;&gt;requisition_id&lt;/font&gt; y no solo el hotel: dos requisiciones del mismo hotel evalúan su umbral por separado, y sus horas &lt;b&gt;no se suman&lt;/b&gt;.&lt;br&gt;&lt;br&gt;El cálculo, por jornada:&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#1A5276&quot;&gt;gross_minutes = Salida − Entrada&lt;br&gt;net_minutes&amp;#160;&amp;#160; = gross − 30&amp;#160;&amp;#160; (GENERATED)&lt;br&gt;overtime&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; = lo que exceda 40h en la semana&lt;br&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; de ESA requisición&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;El overtime NO es un CHECK.&lt;/b&gt; Se evaluó y no funciona, por dos razones: un CHECK solo ve su propia fila —las horas esperadas viven en &lt;font face=&quot;Courier New&quot;&gt;demand.position&lt;/font&gt;, en otra tabla— y un CHECK solo sabe &lt;b&gt;rechazar&lt;/b&gt;, mientras que el overtime es un hecho que hay que &lt;b&gt;registrar y pagar&lt;/b&gt;. No se tira un ponche porque el colaborador se quedó tarde.&lt;br&gt;&lt;br&gt;Lo único que sí merece CHECK es el absurdo: &lt;font face=&quot;Courier New&quot;&gt;gross_minutes BETWEEN 0 AND 1440&lt;/font&gt;. Un día no puede tener 25 horas, y eso atrapa un ponche corrupto o un error de zona horaria.&lt;br&gt;&lt;br&gt;&lt;b&gt;Quien autoriza rebasar las 40h es el Manager de Área&lt;/b&gt;, y solo él. El disparador es el ponche que cruza el acumulado de la semana en esa requisición — el sistema lo sabe antes del cierre porque lleva la cuenta." vertex="1">
          <mxGeometry height="430" width="640" x="40" y="130" as="geometry" />
        </mxCell>
        <mxCell id="n2-apr" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;2 · Dos roles distintos: revisar y aprobar&lt;/b&gt;&lt;br&gt;&lt;br&gt;No es lo mismo, y el modelo los separa en tablas distintas:&lt;br&gt;&lt;br&gt;&lt;b&gt;El Supervisor REVISA&lt;/b&gt; — y lo hace por jornada, así que &lt;font face=&quot;Courier New&quot;&gt;reviewed_by&lt;/font&gt; vive en &lt;font face=&quot;Courier New&quot;&gt;timesheet_day&lt;/font&gt;. Resuelve los ponches anómalos (fuera del perímetro, sin foto, o con desfase entre captura y sincronización) y registra los manuales. &lt;b&gt;No aprueba.&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;El Manager de Área APRUEBA&lt;/b&gt; — y cubre todos los días, así que &lt;font face=&quot;Courier New&quot;&gt;approved_by&lt;/font&gt; vive en &lt;font face=&quot;Courier New&quot;&gt;timesheet&lt;/font&gt;, no en el día. La aprobación es &lt;b&gt;por departamento&lt;/b&gt;; el Manager General puede aprobar la de cualquiera.&lt;br&gt;&lt;br&gt;Son los &lt;b&gt;dos únicos roles&lt;/b&gt; que aprueban horas, y es la misma pareja que autoriza requisiciones: quien puede autorizarla es quien puede aprobar las horas que genera.&lt;br&gt;&lt;br&gt;&lt;b&gt;Y si nadie aprueba, no pasa nada.&lt;/b&gt; Literalmente: las horas quedan en &lt;font face=&quot;Courier New&quot;&gt;pending_approval&lt;/font&gt;, no se pagan ni se facturan, y &lt;b&gt;el plazo no vence&lt;/b&gt;. Por eso &lt;font face=&quot;Courier New&quot;&gt;timesheet&lt;/font&gt; no lleva fecha límite: no hay aprobación automática ni escalamiento. Solo el Manager General puede aprobar en cualquier momento lo que el Manager de Área no aprobó.&lt;br&gt;&lt;br&gt;&lt;i&gt;Consecuencia para el modelo: el estado de aprobación tiene que ser explícito, porque un timesheet sin aprobar y uno aprobado se ven igual salvo por esa columna.&lt;/i&gt;" vertex="1">
          <mxGeometry height="430" width="640" x="700" y="130" as="geometry" />
        </mxCell>
        <mxCell id="n2-abs" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;3 · El contador de inasistencias, que cierra el Semáforo&lt;/b&gt;&lt;br&gt;&lt;br&gt;La regla de &lt;b&gt;3 inasistencias → Negro&lt;/b&gt; lleva pendiente desde el diagrama del Colaborador, donde se decidió a propósito &lt;b&gt;no&lt;/b&gt; agregar un &lt;font face=&quot;Courier New&quot;&gt;absence_count&lt;/font&gt; a &lt;font face=&quot;Courier New&quot;&gt;worker&lt;/font&gt;: habría sido un contador desnormalizado sin fuente que lo respalde, desincronizado desde el primer día.&lt;br&gt;&lt;br&gt;Aquí aparece la fuente. Una inasistencia es un &lt;font face=&quot;Courier New&quot;&gt;timesheet_day&lt;/font&gt; con turno planeado y &lt;b&gt;sin ponche de Entrada&lt;/b&gt;:&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#1A5276&quot;&gt;is_absence = existe schedule_entry para ese&lt;br&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; día Y no hay punch_mark&lt;br&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; de tipo CLOCK_IN&lt;/font&gt;&lt;br&gt;&lt;br&gt;Y el contador se cuenta, no se guarda:&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#1A5276&quot;&gt;SELECT count(*) FROM timesheet_day&lt;br&gt;&amp;#160;WHERE worker_id = $1 AND is_absence&lt;br&gt;&amp;#160;&amp;#160;&amp;#160;AND NOT protegido_por_gris&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;La protección de Gris importa aquí:&lt;/b&gt; mientras el colaborador está accidentado, las inasistencias &lt;b&gt;no cuentan&lt;/b&gt;. Eso se resuelve cruzando la fecha contra &lt;font face=&quot;Courier New&quot;&gt;personal.worker_state_history&lt;/font&gt; — que existe justo para poder preguntar en qué estado estaba en una fecha dada." vertex="1">
          <mxGeometry height="380" width="640" x="40" y="590" as="geometry" />
        </mxCell>
        <mxCell id="n2-deuda" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;4 · Lo que este diagrama NO cierra&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;a) La deducción de breaks.&lt;/b&gt; &lt;i&gt;Timesheet.md&lt;/i&gt; lo dice con todas sus letras: los breaks ya no se ponchan, así que hoy &lt;b&gt;no se deducen&lt;/b&gt;. Antes se descontaba el tiempo real del par Salida/Entrada de Break. La decisión pendiente es eliminar la deducción o recuperar la captura — y eso cambia lo que se paga.&lt;br&gt;&lt;br&gt;&lt;b&gt;b) El Indicador de Lunch Extendido no se puede calcular.&lt;/b&gt; Con tres marcas no hay fin de comida, así que no hay duración que comparar contra los 30 minutos. La definición se conserva en el vault, pero el indicador está muerto mientras el mecanismo sea de tres marcas.&lt;br&gt;&lt;br&gt;&lt;b&gt;c) Los días festivos.&lt;/b&gt; &lt;i&gt;Schedule.md&lt;/i&gt; dice que se registran &quot;como datos de la operación&quot; para alimentar el módulo de &lt;b&gt;forecast&lt;/b&gt;, que está sin definir. Y el Contrato pacta &lt;i&gt;&quot;2x bill rate en días festivos&quot;&lt;/i&gt;, pero el &lt;i&gt;Consolidado&lt;/i&gt; admite que la regla de cálculo del recargo &lt;b&gt;aún no está definida&lt;/b&gt;. Se aplaza: modelarlo ahora sería adivinar la forma de un cálculo que nadie escribió.&lt;br&gt;&lt;br&gt;&lt;b&gt;d) La válvula de escape del ponche bloqueado.&lt;/b&gt; Si el GPS falla dentro de la propiedad, el colaborador no puede ponchar y no cobra. El &lt;b&gt;Supervisor lo registra&lt;/b&gt; y el &lt;b&gt;Manager de Área lo aprueba&lt;/b&gt; (2026-08-13) — mismo reparto que el resto de las horas. Sigue faltando con qué EVIDENCIA se justifica." vertex="1">
          <mxGeometry height="380" width="640" x="700" y="590" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="op3" name="3 - Restricciones que sostienen el modelo">
    <mxGraphModel dx="862" dy="608" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="2954" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=8;fontSize=13;" value="&lt;b&gt;Las restricciones que sostienen el modelo&lt;/b&gt;&lt;br&gt;Toda regla que pueda vivir como restricción, vive ahí. Estas son las de este diagrama, con lo que rechaza cada una." vertex="1">
          <mxGeometry height="80" width="1000" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="r1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;1 · RR-05 — sin solape de horas, por fin&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#1A5276&quot;&gt;ALTER TABLE operations.schedule_entry&lt;br&gt;&amp;#160;&amp;#160;ADD CONSTRAINT no_shift_overlap&lt;br&gt;&amp;#160;&amp;#160;EXCLUDE USING gist (&lt;br&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;worker_id&amp;#160;&amp;#160; WITH =,&lt;br&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;shift_range WITH &amp;amp;&amp;amp;&lt;br&gt;&amp;#160;&amp;#160;);&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;La regla que ningun diagrama anterior pudo hacer cumplir. Va sobre el turno PLANEADO porque el choque hay que impedirlo al asignar, no descubrirlo cuando el colaborador ya se presento. Y como shift_range es un tstzrange con fecha Y hora, sale gratis lo dificil: el turno nocturno que cruza medianoche, y los dias alternados. Necesita worker_id denormalizado desde assignment — ver la desviacion 1.&lt;/i&gt;" vertex="1">
          <mxGeometry height="273" width="1280" x="40" y="130" as="geometry" />
        </mxCell>
        <mxCell id="r2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;2 · Una sola marca de cada tipo por jornada&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#1A5276&quot;&gt;CREATE UNIQUE INDEX ux_punch_day_type&lt;br&gt;&amp;#160;&amp;#160;ON operations.punch_mark (timesheet_day_id, type);&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Reglas de Negocio: &quot;ponche duplicado en la misma jornada: el sistema bloquea&quot;. Tres marcas por jornada, una de cada tipo. Corregir una es registrar un ponche MANUAL, no insertar otra igual.&lt;/i&gt;" vertex="1">
          <mxGeometry height="175" width="1280" x="40" y="423" as="geometry" />
        </mxCell>
        <mxCell id="r3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;3 · El orden de las marcas&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#1A5276&quot;&gt;ALTER TABLE operations.punch_mark&lt;br&gt;&amp;#160;&amp;#160;ADD CONSTRAINT ck_punch_type&lt;br&gt;&amp;#160;&amp;#160;CHECK (type IN ('CLOCK_IN', 'LUNCH_OUT',&lt;br&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;'LUNCH_IN', 'CLOCK_OUT'));&lt;br&gt;&lt;br&gt;-- La foto solo se exige en Entrada y Salida.&lt;br&gt;ALTER TABLE operations.punch_mark&lt;br&gt;&amp;#160;&amp;#160;ADD CONSTRAINT ck_punch_photo&lt;br&gt;&amp;#160;&amp;#160;CHECK (type IN ('LUNCH_OUT','LUNCH_IN')&lt;br&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; OR photo_path IS NOT NULL);&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Las marcas de lunch no llevan foto: el vault solo la exige en Entrada y Salida. Y son OPCIONALES, asi que su ausencia NO es un error: el sistema deduce los 30 minutos igual.  El orden entre marcas (no ponchar Comida sin Entrada) NO va como CHECK — es una regla entre FILAS, y un CHECK solo ve la suya. Vive en el servicio.&lt;/i&gt;" vertex="1">
          <mxGeometry height="315" width="1280" x="40" y="618" as="geometry" />
        </mxCell>
        <mxCell id="r4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;4 · Un solo timesheet por colaborador, semana y requisicion&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#1A5276&quot;&gt;CREATE UNIQUE INDEX ux_timesheet_worker_week_req&lt;br&gt;&amp;#160;&amp;#160;ON operations.timesheet (worker_id, week_start, requisition_id);&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Es lo que hace que el umbral de 40h se evalue por requisicion y no se sumen las horas entre ellas. Sin este unico, dos filas para la misma semana partirian el acumulado y nadie llegaria a las 40.&lt;/i&gt;" vertex="1">
          <mxGeometry height="175" width="1280" x="40" y="953" as="geometry" />
        </mxCell>
        <mxCell id="r5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;5 · Una jornada por dia&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#1A5276&quot;&gt;CREATE UNIQUE INDEX ux_timesheet_day&lt;br&gt;&amp;#160;&amp;#160;ON operations.timesheet_day (timesheet_id, work_date);&lt;br&gt;&lt;br&gt;-- Y el dia tiene que caer dentro de su semana.&lt;br&gt;ALTER TABLE operations.timesheet_day&lt;br&gt;&amp;#160;&amp;#160;ADD CONSTRAINT ck_day_in_week CHECK (true);&amp;#160;&amp;#160;-- via trigger o FK compuesta&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;La segunda no se puede escribir como CHECK simple porque week_start vive en el padre. Se resuelve con FK compuesta o trigger; queda anotado, no resuelto.&lt;/i&gt;" vertex="1">
          <mxGeometry height="231" width="1280" x="40" y="1148" as="geometry" />
        </mxCell>
        <mxCell id="r6" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;6 · Un dia no puede tener 25 horas&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#1A5276&quot;&gt;ALTER TABLE operations.timesheet_day&lt;br&gt;&amp;#160;&amp;#160;ADD CONSTRAINT ck_day_minutes&lt;br&gt;&amp;#160;&amp;#160;CHECK (gross_minutes BETWEEN 0 AND 1440);&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;El unico CHECK que el overtime merece: el absurdo. Atrapa un ponche corrupto o un error de zona horaria, que es exactamente el tipo de bug que se descubre tres meses despues en la nomina.&lt;/i&gt;" vertex="1">
          <mxGeometry height="189" width="1280" x="40" y="1399" as="geometry" />
        </mxCell>
        <mxCell id="r7" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;7 · Las horas netas son derivadas&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#1A5276&quot;&gt;-- En una VISTA, no en columna GENERATED.&lt;br&gt;CREATE VIEW operations.vw_timesheet_day AS&lt;br&gt;SELECT d.*,&lt;br&gt;&amp;#160;&amp;#160;greatest(0, d.gross_minutes - d.lunch_deduction_minutes) AS net_minutes&lt;br&gt;FROM operations.timesheet_day d;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Misma leccion que personal.vw_worker: Prisma no sabe representar una columna GENERATED y su diff queda en un bucle que rompe la siguiente migracion. La vista consigue lo mismo. El greatest(0,...) evita netos negativos en una jornada mas corta que la deduccion.&lt;/i&gt;" vertex="1">
          <mxGeometry height="231" width="1280" x="40" y="1608" as="geometry" />
        </mxCell>
        <mxCell id="r8" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;8 · Solo lo aprobado paga&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#1A5276&quot;&gt;ALTER TABLE operations.timesheet&lt;br&gt;&amp;#160;&amp;#160;ADD CONSTRAINT ck_timesheet_approval CHECK (&lt;br&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;(status = 'approved' AND approved_by IS NOT NULL&lt;br&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;AND approved_at IS NOT NULL)&lt;br&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;OR (status &amp;lt;&amp;gt; 'approved' AND approved_by IS NULL&lt;br&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;AND approved_at IS NULL)&lt;br&gt;&amp;#160;&amp;#160;);&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;D-09: solo el ponche aprobado paga. El CHECK impide que algo quede marcado como aprobado sin decir quien ni cuando — que es justo lo que haria imposible auditar una nomina.&lt;/i&gt;" vertex="1">
          <mxGeometry height="245" width="1280" x="40" y="1859" as="geometry" />
        </mxCell>
        <mxCell id="r9" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;9 · La geocerca&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#1A5276&quot;&gt;coordinates public.geography(Point, 4326)&lt;br&gt;&lt;br&gt;-- La valida el SERVIDOR, no el telefono (D-08).&lt;br&gt;ST_DWithin(coordinates, hotel.geofence, hotel.radius_m)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;El telefono no es de fiar: un dispositivo rooteado puede mentir sobre su ubicacion. inside_geofence lo calcula el servidor al recibir la marca, y por eso es una columna guardada y no un calculo al vuelo — la geocerca del hotel puede cambiar despues, y el ponche tiene que conservar el veredicto que se dio en su momento.&lt;/i&gt;" vertex="1">
          <mxGeometry height="231" width="1280" x="40" y="2124" as="geometry" />
        </mxCell>
        <mxCell id="r10" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;10 · El ponche manual deja rastro&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#1A5276&quot;&gt;ALTER TABLE operations.punch_mark&lt;br&gt;&amp;#160;&amp;#160;ADD CONSTRAINT ck_punch_manual CHECK (&lt;br&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;(is_manual = false AND registered_by IS NULL&lt;br&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; AND manual_reason IS NULL)&lt;br&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;OR (is_manual = true AND registered_by IS NOT NULL&lt;br&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; AND manual_reason IS NOT NULL)&lt;br&gt;&amp;#160;&amp;#160;);&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Un ponche manual es una excepcion a la evidencia: no hay GPS ni foto que lo respalde, solo la palabra del Supervisor. Por eso los tres campos van juntos o no van. PENDIENTE: el vault no dice quien autoriza el manual ni con que evidencia.&lt;/i&gt;" vertex="1">
          <mxGeometry height="259" width="1280" x="40" y="2375" as="geometry" />
        </mxCell>
        <mxCell id="r-desv" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;Las desviaciones deliberadas&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1. schedule_entry.worker_id está desnormalizado&lt;/b&gt; — se puede llegar por &lt;font face=&quot;Courier New&quot;&gt;assignment&lt;/font&gt;.&lt;br&gt;&lt;i&gt;Por qué: la restricción de exclusión de RR-05 necesita las dos columnas EN LA MISMA FILA. Un EXCLUDE no puede hacer JOIN. Sin la columna, la regla más importante de este esquema no se puede escribir.&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;2. timesheet_day.gross_minutes se guarda&lt;/b&gt; — se puede derivar de los ponches.&lt;br&gt;&lt;i&gt;Por qué: los ponches se pueden corregir con un manual, y el bruto de la jornada tiene que quedar congelado al aprobar. Si se derivara, aprobar una nómina y recalcularla darían números distintos.&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;3. punch_mark.inside_geofence se guarda&lt;/b&gt; — se puede calcular con PostGIS al vuelo.&lt;br&gt;&lt;i&gt;Por qué: la geocerca del hotel puede cambiar. El ponche tiene que conservar el veredicto que se dio en su momento, no el que daría hoy.&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;4. timesheet.requisition_id está desnormalizado&lt;/b&gt; — se llega por &lt;font face=&quot;Courier New&quot;&gt;assignment → slot → position → requisition&lt;/font&gt;.&lt;br&gt;&lt;i&gt;Por qué: son tres JOINs, y el umbral de 40h se consulta en cada ponche.&lt;/i&gt;" vertex="1">
          <mxGeometry height="250" width="1280" x="40" y="2664" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
